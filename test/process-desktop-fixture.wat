  (func (export "fixture_window")
      (param $h i32) (param $p i32) (param $c i32) (param $t i32) (param $s i32) (param $wc i32)
    (drop (call $class_table_register_data (call $class_name_key (local.get $c)) (call $g2w (local.get $wc))))
    (call $wnd_table_set (local.get $h) (i32.const 0x00401000))
    (call $wnd_set_parent (local.get $h) (local.get $p))
    (drop (call $wnd_set_style (local.get $h) (local.get $s)))
    (call $wnd_set_class_slot_from_name (local.get $h) (local.get $c))
    (call $title_table_set (local.get $h) (call $g2w (local.get $t))
      (call $lstr_len (local.get $t) (i32.const 0))))
  (func (export "fixture_title") (param $h i32) (param $t i32)
    (call $title_table_set (local.get $h) (call $g2w (local.get $t))
      (call $lstr_len (local.get $t) (i32.const 0))))
  (func (export "fixture_remove") (param $h i32) (call $wnd_table_remove (local.get $h)))
  (func (export "fixture_find_ex")
      (param $p i32) (param $a i32) (param $c i32) (param $t i32) (result i32)
    (i32.store offset=16 (global.get $reg_base) (i32.const 0x00300000))
    (call $handle_FindWindowExA (local.get $p) (local.get $a)
      (local.get $c) (local.get $t) (i32.const 0) (i32.const 0))
    (i32.load (global.get $reg_base)))
  (func (export "fixture_find_w") (param $c i32) (param $t i32) (result i32)
    (i32.store offset=16 (global.get $reg_base) (i32.const 0x00300000))
    (call $handle_FindWindowW (local.get $c) (local.get $t)
      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0))
    (i32.load (global.get $reg_base)))
  (func (export "fixture_post")
      (param $h i32) (param $m i32) (param $w i32) (param $l i32) (result i32)
    (i32.store offset=16 (global.get $reg_base) (i32.const 0x00300000))
    (call $handle_PostMessageA (local.get $h) (local.get $m)
      (local.get $w) (local.get $l) (i32.const 0) (i32.const 0))
    (i32.load (global.get $reg_base)))
  (func (export "fixture_send")
      (param $h i32) (param $m i32) (param $w i32) (param $l i32) (result i32)
    (i32.store offset=16 (global.get $reg_base) (i32.const 0x00300000))
    (call $handle_SendMessageA (local.get $h) (local.get $m)
      (local.get $w) (local.get $l) (i32.const 0) (i32.const 0))
    (i32.load (global.get $reg_base)))
  (func (export "fixture_last_error") (result i32) (global.get $last_error))
