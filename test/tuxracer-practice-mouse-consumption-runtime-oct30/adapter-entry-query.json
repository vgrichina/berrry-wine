"{\"sha256\": \"e7b59c046f63b504a0aba256b644a42c01f820fde9a0f9e5fee3961dae397f78\", \"excerpt\": \"1813:   P.handleMouseDown = function(canvasX, canvasY, button, opts) {\\n1814:     const mapped = this._mapExclusiveInputPoint(canvasX, canvasY);\\n1815:     if (mapped.outside) return;\\n1816:     canvasX = mapped.x;\\n1817:     canvasY = mapped.y;\\n1818:     const clipped = this._applyCursorClip(canvasX, canvasY);\\n1819:     canvasX = clipped.x;\\n1820:     canvasY = clipped.y;\\n1821:     const forceDoubleClick = !!(opts && opts.doubleClick);\\n1822:     const buttonMask = this._mouseMaskForButton(button);\\n1823:     const ctrlDown = !!((opts && opts.ctrlKey) || this._ctrlDown);\\n1824:     const shiftDown = !!((opts && opts.shiftKey) || this._shiftDown);\\n1825:     const mouseWParam = buttonMask | (shiftDown ? 0x0004 : 0) | (ctrlDown ? 0x0008 : 0);\\n1826:     const inputWin = this._inputWindowAtPoint(canvasX, canvasY);\\n1827:     const inputWasm = (inputWin && inputWin.wasm) || this.wasm;\\n1828:     const inputMemory = (inputWin && inputWin.wasmMemory) || this.wasmMemory;\\n1829:     this._pointerInputWasm = inputWasm;\\n1830:     this._pointerInputMemory = inputMemory;\\n1831:     const buttonsBefore = this._mouseButtonsMask || 0;\\n1832:     this._mouseButtonsMask = (this._mouseButtonsMask || 0) | buttonMask;\\n1833:     if (!(buttonsBefore & buttonMask)) {\\n1834:       this._queueDirectInputMouseButton(inputMemory, buttonMask, true);\\n1835:     }\\n1836:     this._signalDirectInputDevice(2);\\n2409:   P.handleMouseUp = function(canvasX, canvasY, button) {\\n2410:     const mapped = this._mapExclusiveInputPoint(canvasX, canvasY);\\n2411:     if (this.onInputTrace) {\\n2412:       const d = this._directMouseDown;\\n2413:       const g = this._dialogBtnDrag;\\n2414:       this._traceInput(`up ${canvasX},${canvasY} enter:`\\n2415:         + ` outside=${mapped.outside ? 1 : 0}`\\n2416:         + ` directDown=${d ? '0x' + (d.targetHwnd >>> 0).toString(16) : 'none'}`\\n2417:         + ` btnDrag=${g ? '0x' + (g.parent >>> 0).toString(16) : 'none'}`\\n2418:         + ` resizing=${this._resizingWin ? 1 : 0} dragging=${this._draggingWin ? 1 : 0}`);\\n2419:     }\\n2420:     if (mapped.outside) {\\n2421:       const mask = this._mouseMaskForButton(button);\\n2422:       const wasDown = !!((this._mouseButtonsMask || 0) & mask);\\n2423:       this._mouseButtonsMask = (this._mouseButtonsMask || 0) & ~mask;\\n2424:       if (wasDown) this._queueDirectInputMouseButton(this._pointerInputMemory || this.wasmMemory, mask, false);\\n2425:       this._pointerInputMemory = null;\\n2426:       this._pointerInputWasm = null;\\n2427:       this._signalDirectInputDevice(2);\\n2428:       return;\\n2429:     }\\n2430:     canvasX = mapped.x;\\n2431:     canvasY = mapped.y;\\n2432:     const clipped = this._applyCursorClip(canvasX, canvasY);\\n2764:   P.handleMouseMove = function(canvasX, canvasY, motion) {\\n2765:     const mapped = this._mapExclusiveInputPoint(canvasX, canvasY);\\n2766:     if (mapped.outside) return;\\n2767:     canvasX = mapped.x;\\n2768:     canvasY = mapped.y;\\n2769:     const clipped = this._applyCursorClip(canvasX, canvasY);\\n2770:     canvasX = clipped.x;\\n2771:     canvasY = clipped.y;\\n2772:     const inputWin = this._inputWindowAtPoint(canvasX, canvasY);\\n2773:     const inputMemory = (inputWin && inputWin.wasmMemory) || this.wasmMemory;\\n2774:     if (inputMemory) {\\n2775:       if (!this._directInputMousePoints) this._directInputMousePoints = new WeakMap();\\n2776:       const previous = this._directInputMousePoints.get(inputMemory);\\n2777:       let dx = 0, dy = 0;\\n2778:       if (motion && motion.relative) {\\n2779:         dx = Number.isFinite(motion.directDx)\\n2780:           ? (motion.directDx | 0) : canvasX - (this._mouseX || 0);\\n2781:         dy = Number.isFinite(motion.directDy)\\n2782:           ? (motion.directDy | 0) : canvasY - (this._mouseY || 0);\\n2783:       } else if (previous && !(motion && motion.teleport)) {\\n2784:         dx = canvasX - previous.x;\\n2785:         dy = canvasY - previous.y;\\n2786:       }\\n2787:       // motion.teleport says the pointer APPEARED here rather than travelled\"}\n"
