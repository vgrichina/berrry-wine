==[P[1:]]\nemit('fresh-original',inode=fresh,leaf=leaf,left=left,right=right)\nfor step,src,dst,parent in [('fresh-moved',F,G,right),('fresh-moved-back',G,F,left)]:\n    os.rename(src,dst);assert absent(src)\n    assert os.stat(dst).st_ino==fresh and os.stat(dst+N).st_ino==leaf\n    assert os.stat(dst+'/..').st_ino==parent and os.stat(dst+N+'/..').st_ino==fresh\n    assert os.listdir(dst)==[N[1:]] and os.listdir(dst+N)==[P[1:]]\n    with open(dst+N+P,'rb') as f:actual=f.read()\n    assert actual==B\n    emit(step,path=dst,parent=parent,inode=fresh,leaf=leaf,oldAbsent=True,sha256=hashlib.sha256(actual).hexdigest())\nos.unlink(F+N+P);os.rmdir(F+N);os.rmdir(F)\nos.unlink(S+C);os.rmdir(S);os.rmdir(L);os.rmdir(D)\nassert os.listdir(R)==[];emit('cleanup',empty=True)\n"], "cwd": "/tmp/tvsa-stage/repo", "startedAt": "2026-10-30T12:02:50.956049+00:00", "finishedAt": "2026-10-30T12:02:51.171774+00:00", "exit": 0, "wall": 0.21575169600004074, "groupPeakRSS": 48758784, "mountOwnership": ["459 29 0:51 / /tmp/tvsa/domain rw,nosuid,nodev,relatime shared:473 - fuse.toyvm-accounting toyvm-accounting rw,user_id=1000,group_id=1000"], "counterSamples": [{"at": 509.03780261, "state": {"live": 4096, "peak": 4096, "written": 0, "failure": null, "inodes": 1, "openHandles": 0, "operations": 1, "liveLimit": 65536, "writeLimit": 65536, "fileLimit": 16384, "accounting": "synchronous FUSE, direct_io, no writeback cache; 4096 metadata charge per inode plus rounded dense payload"}}, {"at": 509.098512153, "state": {"live": 4096, "peak": 40960, "written": 46, "failure": null, "inodes": 1, "openHandles": 0, "operations": 266, "liveLimit": 65536, "writeLimit": 65536, "fileLimit": 16384, "accounting": "synchronous FUSE, direct_io, no writeback cache; 4096 metadata charge per inode plus rounded dense payload"}}], "violation": null, "stdout": "{\"accepted\": true, \"accountingAccepted\": true, \"backendReceipt\": {\"cleanupComplete\": true, \"cpuSeconds\": 0.114473, \"exit\": 0, \"filesystem\": {\"accou