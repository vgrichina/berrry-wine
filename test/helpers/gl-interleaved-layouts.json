  "acceptanceCases": [
    "All14 formats: packed stride0 and explicit padded stride; nonzero base pointer and nonzero draw first/index offsets.",
    "Color unsigned bytes normalize correctly; three-component color gets implicit alpha1; vertex and texture defaults obey GL rules.",
    "Display-list compilation performs setup immediately; replay must not restore captured client pointers.",
    "Client attribute push/pop saves array state; server attribute push/pop does not.",
    "Only client-active texture array changes; other units preserve pointers/enables.",
    "Invalid format and negative stride preserve prior state and report errors.",
    "Confirm required absent-component enable/disable and untouched pointer semantics against full primary specification before implementation.",
    "Use independent position/color/normal/texture pixel oracles, not layout-table self-comparison alone."
  ],
  "negativeControls": [
