    exit_thread_after_dll_unload(code) { assert.equal(code, 73); y = 2; eip = 0; },
    run() {
      runs++;
      if (runs === 1) {
        if (mode === 'sleep') { halt = 3; sleepPending = true; }
        else { halt = 4; y = 1; }
        return;
