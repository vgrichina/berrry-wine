    stats: () => ({ runs, takes, maps, completion, errorCode, elapsed }),
    setOwner: v => { owner = v; },
    seed() { ex.load_dll(); put(0, 0, 2); put(0, 12, 0); put(0, 48, 1); },
    start: () => boot.beginScopedLibraryYield({ exports: ex, memoryBuffer: memory.buffer,
