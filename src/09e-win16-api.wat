    (call $win16_api_return (i32.const 12))
    (i32.const 1))

  ;; 1211 mmioClose(hmmio, wFlags)
  (func $win16_mmioClose
    (local $o i32) (local $h i32) (local $fh i32)
    (local.set $h (call $win16_arg16 (i32.const 1)))
