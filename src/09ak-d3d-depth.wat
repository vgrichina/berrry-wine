    (then (return (i32.const 0))))
  (i32.store offset=44 (local.get $wa) (i32.const 1)) (i32.const 1))
(func $d3d9_depth_collect (param $surface i32)
  (local $wa i32)
  (if (i32.eqz (local.get $surface)) (then (return)))
  (local.set $wa (call $g2w (local.get $surface)))
  (if (i32.or (i32.load offset=4 (local.get $wa)) (i32.load offset=16 (local.get $wa))) (then (return)))
  ;; Host copies identity before returning; the ordered queue owns its release.
  (if (i32.eqz (call $d3d9_depth_retire (local.get $surface))) (then (return)))
  (i32.store offset=12 (local.get $wa) (i32.const 0))
  (call $heap_free (local.get $surface)))
(func $d3d9_depth_unbind (param $surface i32)
  (local $wa i32)
  (if (i32.eqz (local.get $surface)) (then (return)))
  (local.set $wa (call $g2w (local.get $surface)))
  (i32.store offset=16 (local.get $wa) (i32.sub (i32.load offset=16 (local.get $wa)) (i32.const 1)))
