;; D3D9 depth surface identities. Device state tail: +21752 bound depth,
;; +21756 automatic depth owner, +21760 auto format, +21764 auto enabled.
;; Surface48: vtable, external refs, device, marker05, binding refs,
;; width,height,format,discard,monotonic backend identity,reserved,reserved.
;; Depth/stencil formats here implement depth only; stencil operations reject.
;; Shared across guest-thread instances. No initializer resets this sequence;
;; exhaustion is permanent, including when allocation subsequently fails.
(global $D3D9_DEPTH_SERIAL i32 (region.addr $D3D9_DEPTH_SERIAL 0))
(global $D3D9_DEPTH_SERIAL_SIZE i32 (region.size $D3D9_DEPTH_SERIAL))
(func $d3d9_depth_next_serial (result i32)
  (local $old i32)
  (loop $retry
    (local.set $old (i32.atomic.load (global.get $D3D9_DEPTH_SERIAL)))
    (if (i32.eq (local.get $old) (i32.const -1)) (then (return (i32.const 0))))
    (br_if $retry (i32.ne (i32.atomic.rmw.cmpxchg (global.get $D3D9_DEPTH_SERIAL)
      (local.get $old) (i32.add (local.get $old) (i32.const 1))) (local.get $old))))
  (i32.add (local.get $old) (i32.const 1)))
