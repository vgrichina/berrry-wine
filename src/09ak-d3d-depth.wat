  (if (i32.eqz (call $d3d9_depth_format (local.get $format))) (then (return (i32.const 0))))
  (local.set $serial (call $d3d9_depth_next_serial))
  (if (i32.eqz (local.get $serial)) (then (return (i32.const 0))))
  (local.set $surface (call $heap_alloc (i32.const 48)))
  (if (i32.eqz (local.get $surface)) (then (return (i32.const 0))))
  (local.set $wa (call $g2w (local.get $surface))) (memory.fill (local.get $wa) (i32.const 0) (i32.const 48))
