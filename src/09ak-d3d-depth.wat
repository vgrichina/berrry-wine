;; Count externally owned default-pool resources/state blocks/depth surfaces.
;; Internal bindings do not prevent Reset; externally retained objects do.
(func $d3d9_reset_resource (param $wa i32) (param $delta i32)
  (local $kind i32) (local $tracked i32) (local $state i32)
  (local.set $kind (i32.load offset=12 (local.get $wa)))
  (local.set $tracked (i32.or (i32.eq (local.get $kind) (i32.const 0xd3d90003))
    (i32.eq (local.get $kind) (i32.const 0xd3d90005))))
  (if (i32.eq (local.get $kind) (i32.const 0xd3d90006))
    (then (local.set $tracked (i32.eqz (i32.load offset=60 (local.get $wa))))))
  (if (i32.or (i32.eq (local.get $kind) (i32.const 6)) (i32.eq (local.get $kind) (i32.const 7)))
    (then (local.set $tracked (i32.eqz (i32.load offset=36 (local.get $wa))))))
  (if (i32.or (i32.eq (local.get $kind) (i32.const 3)) (i32.eq (local.get $kind) (i32.const 5)))
    (then (local.set $tracked (i32.eqz (i32.load offset=44 (local.get $wa))))))
  (if (i32.eqz (local.get $tracked)) (then (return)))
  (local.set $state (call $g2w (call $d3d9_program_state (i32.load offset=8 (local.get $wa)))))
  (i32.store offset=21772 (local.get $state) (i32.add (i32.load offset=21772 (local.get $state)) (local.get $delta))))
(func $d3d9_depth_format (param $format i32) (result i32)
  (i32.or (i32.eq (local.get $format) (i32.const 80))
    (i32.or (i32.eq (local.get $format) (i32.const 75)) (i32.eq (local.get $format) (i32.const 77)))))
(func $d3d9_is_depth_surface (param $surface i32) (result i32)
  (if (i32.eqz (local.get $surface)) (then (return (i32.const 0))))
  (i32.eq (call $gl32 (i32.add (local.get $surface) (i32.const 12))) (i32.const 0xd3d90005)))
(func $d3d9_depth_addref (param $surface i32) (result i32)
  (local $wa i32) (local $entry i32) (local $refs i32)
  (local.set $wa (call $g2w (local.get $surface)))
  (local.set $refs (i32.load offset=4 (local.get $wa)))
  (if (i32.eqz (local.get $refs)) (then
    (call $d3d9_reset_resource (local.get $wa) (i32.const 1))
    (local.set $entry (call $dx_from_this (i32.load offset=8 (local.get $wa))))
    (store.field DxObject refcount (local.get $entry) (i32.add (load.field DxObject refcount (local.get $entry)) (i32.const 1)))))
  (local.set $refs (i32.add (local.get $refs) (i32.const 1)))
  (i32.store offset=4 (local.get $wa) (local.get $refs)) (local.get $refs))
(func $d3d9_depth_retire (param $surface i32) (result i32)
  (local $wa i32)
  (local.set $wa (call $g2w (local.get $surface)))
  (if (i32.load offset=44 (local.get $wa)) (then (return (i32.const 1))))
  (if (i32.ne (call $host_gpu_gl_call
