  (local.set $state (call $d3d9_program_state (local.get $device)))
  (if (i32.eqz (local.get $state)) (then (return)))
  (local.set $old (call $gl32 (i32.add (local.get $state) (i32.const 21752))))
  (if (local.get $get) (then
    (if (i32.eqz (local.get $surface)) (then (return)))
    (call $gs32 (local.get $surface) (local.get $old))
    (if (i32.eqz (local.get $old)) (then (i32.store offset=0 (global.get $reg_base) (i32.const 0x88760866)) (return)))
    (drop (call $d3d9_depth_addref (local.get $old)))
