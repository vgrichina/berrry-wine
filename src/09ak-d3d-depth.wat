  (i32.store offset=12 (local.get $wa) (i32.const 0xd3d90005))
  (i32.store offset=20 (local.get $wa) (local.get $width)) (i32.store offset=24 (local.get $wa) (local.get $height))
  (i32.store offset=28 (local.get $wa) (local.get $format)) (i32.store offset=32 (local.get $wa) (local.get $discard))
  (i32.store offset=36 (local.get $wa) (local.get $serial))
  (if (local.get $external) (then (drop (call $d3d9_depth_addref (local.get $surface)))))
