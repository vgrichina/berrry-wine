  (func $toolhelp_unlock (i32.atomic.store (global.get $TOOLHELP_HEAPS) (i32.const 0)))
  (func $toolhelp_bucket (param $ptr i32) (result i32)
    (i32.add (call $g2w (i32.load offset=12 (global.get $TOOLHELP_HEAPS)))
      (i32.shl (i32.and (i32.shr_u (local.get $ptr) (i32.const 3)) (i32.const 1023)) (i32.const 2))))
