  ;; Process-owned, permanently mapped native KERNEL32 identity. Publication
  ;; occurs under DLL_LOAD_LOCK only after the entire image is readable.
  (func $kernel32_module (result i32)
    (i32.atomic.load (region.addr $KERNEL32_MODULE 0)))
  (func $kernel32_is_module (param $module i32) (result i32)
    (i32.and (i32.ne (local.get $module) (i32.const 0))
      (i32.eq (local.get $module) (call $kernel32_module))))

  (func $kernel32_file_name (param $buf i32) (param $size i32) (param $wide i32) (result i32)
    (local $n i32)
    (if (i32.or (i32.eqz (local.get $buf)) (i32.eqz (local.get $size)))
      (then (return (i32.const 0))))
    (local.set $n (call $emit_path_part (local.get $buf) (i32.const 0)
      (i32.sub (local.get $size) (i32.const 1)) (global.get $STATIC_SYS_DIR) (local.get $wide)))
    (local.set $n (call $emit_path_part (local.get $buf) (local.get $n)
      (i32.sub (local.get $size) (i32.const 1)) (region.addr $RESERVED_PAGE_STRINGS 0x30) (local.get $wide)))
    (call $store_char (i32.add (local.get $buf)
      (i32.shl (local.get $n) (select (i32.const 1) (i32.const 0) (local.get $wide))))
      (i32.const 0) (local.get $wide))
    (local.get $n))

  ;; Each EAT entry addresses an in-image x86 JMP to an ordinary native thunk.
  ;; Direct PE walkers and GetProcAddress thus receive precisely the same entry.
  (func $kernel32_emit_export (param $base i32) (param $index i32)
      (param $ordinal i32) (param $api_id i32) (param $name_index i32)
      (param $name_bytes i32) (param $cursor i32) (result i32)
    (local $start i32) (local $code i32) (local $thunk i32)
    (local.set $start (local.get $cursor))
    (local.set $cursor (i32.add (local.get $cursor) (local.get $name_bytes)))
    (global.set $num_thunks (call $thunk_reserve))
    (local.set $thunk (i32.add (global.get $THUNK_BASE)
      (i32.shl (global.get $num_thunks) (i32.const 3))))
    ;; win32_dispatch adds image_base and the two-byte import hint, THEN
    ;; translates with g2w. This must remain a GUEST RVA even in sparse heap.
    (i32.store (local.get $thunk) (i32.sub
      (i32.add (local.get $base) (local.get $start)) (global.get $image_base)))
    (i32.store offset=4 (local.get $thunk) (local.get $api_id))
    (local.set $code (i32.add (i32.const 4096) (i32.shl (local.get $index) (i32.const 3))))
    (call $gs8 (i32.add (local.get $base) (local.get $code)) (i32.const 233))
    (call $gs32 (i32.add (local.get $base) (i32.add (local.get $code) (i32.const 1)))
      (i32.sub (i32.add (i32.sub (local.get $thunk) (global.get $GUEST_BASE)) (global.get $image_base))
        (i32.add (local.get $base) (i32.add (local.get $code) (i32.const 5)))))
    (call $gs32 (i32.add (local.get $base)
      (i32.add (i32.const 8192) (i32.shl (i32.sub (local.get $ordinal) (i32.const 1)) (i32.const 2))))
      (local.get $code))
    (if (i32.ge_s (local.get $name_index) (i32.const 0))
      (then
        (call $gs32 (i32.add (local.get $base)
          (i32.add (i32.const 12288) (i32.shl (local.get $name_index) (i32.const 2))))
          (i32.add (local.get $start) (i32.const 2)))
        (call $gs16 (i32.add (local.get $base)
          (i32.add (i32.const 14336) (i32.shl (local.get $name_index) (i32.const 1))))
          (i32.sub (local.get $ordinal) (i32.const 1)))))
    (global.set $num_thunks (i32.add (global.get $num_thunks) (i32.const 1)))
    (call $update_thunk_end)
    (local.get $cursor))

  (func $kernel32_ensure_locked (result i32)
    (local $base i32) (local $i i32)
    (local.set $base (call $kernel32_module))
    (if (local.get $base) (then (return (local.get $base))))
    (local.set $base (call $heap_alloc (i32.const 65536)))
    (if (i32.eqz (local.get $base))
      (then (global.set $last_error (i32.const 8)) (return (i32.const 0))))
    ;; Clear through the guest translator: a heap allocation can be sparse.
    (loop $clear
      (call $gs32 (i32.add (local.get $base) (local.get $i)) (i32.const 0))
      (local.set $i (i32.add (local.get $i) (i32.const 4)))
      (br_if $clear (i32.lt_u (local.get $i) (i32.const 65536))))
    (call $gs16 (local.get $base) (i32.const 23117)) ;; MZ
    (call $gs32 (i32.add (local.get $base) (i32.const 60)) (i32.const 128))
    (call $gs32 (i32.add (local.get $base) (i32.const 128)) (i32.const 17744)) ;; PE
    (call $gs16 (i32.add (local.get $base) (i32.const 132)) (i32.const 332)) ;; i386
    (call $gs16 (i32.add (local.get $base) (i32.const 134)) (i32.const 1))
    (call $gs16 (i32.add (local.get $base) (i32.const 148)) (i32.const 224))
    (call $gs16 (i32.add (local.get $base) (i32.const 150)) (i32.const 8450))
    (call $gs16 (i32.add (local.get $base) (i32.const 152)) (i32.const 267)) ;; PE32
    (call $gs32 (i32.add (local.get $base) (i32.const 180)) (local.get $base))
    (call $gs32 (i32.add (local.get $base) (i32.const 184)) (i32.const 4096))
    (call $gs32 (i32.add (local.get $base) (i32.const 188)) (i32.const 512))
    (call $gs32 (i32.add (local.get $base) (i32.const 208)) (i32.const 65536))
    (call $gs32 (i32.add (local.get $base) (i32.const 212)) (i32.const 4096))
    (call $gs32 (i32.add (local.get $base) (i32.const 244)) (i32.const 16))
    (call $gs32 (i32.add (local.get $base) (i32.const 248)) (i32.const 16384))
    (call $gs32 (i32.add (local.get $base) (i32.const 252)) (i32.const 4096))
    (call $gs32 (i32.add (local.get $base) (i32.const 376)) (i32.const 0x7865742e)) ;; .tex
    (call $gs8 (i32.add (local.get $base) (i32.const 380)) (i32.const 116))
    (call $gs32 (i32.add (local.get $base) (i32.const 384)) (i32.const 61440))
    (call $gs32 (i32.add (local.get $base) (i32.const 388)) (i32.const 4096))
    (call $gs32 (i32.add (local.get $base) (i32.const 412)) (i32.const 0x60000020))
    ;; IMAGE_EXPORT_DIRECTORY. Ordinals 35/36/37 remain genuine holes.
    (call $gs32 (i32.add (local.get $base) (i32.const 16396)) (i32.const 16448))
    (call $gs32 (i32.add (local.get $base) (i32.const 16400)) (i32.const 1))
    (call $gs32 (i32.add (local.get $base) (i32.const 16404)) (i32.const 1024))
    (call $gs32 (i32.add (local.get $base) (i32.const 16412)) (i32.const 8192))
    (call $gs32 (i32.add (local.get $base) (i32.const 16416)) (i32.const 12288))
    (call $gs32 (i32.add (local.get $base) (i32.const 16420)) (i32.const 14336))
    (call $gs32 (i32.add (local.get $base) (i32.const 16448)) (i32.const 0x4e52454b))
    (call $gs32 (i32.add (local.get $base) (i32.const 16452)) (i32.const 0x32334c45))
    (call $gs32 (i32.add (local.get $base) (i32.const 16456)) (i32.const 0x4c4c442e))
    (call $kernel32_populate_exports (local.get $base))
    (i32.atomic.store (region.addr $KERNEL32_MODULE 0) (local.get $base))
    (local.get $base))
