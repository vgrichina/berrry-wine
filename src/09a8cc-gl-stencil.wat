  ;; Eight-bit stencil. Context +192 owns nine words: enable, func, ref,
  ;; compare mask, write mask, fail, depth-fail, depth-pass, clear value.
  ;; The attachment belongs to the software drawable, not the context.
  (global $gl_stencil_pixels (mut i32) (i32.const 0))
  (global $gl_stencil_pitch (mut i32) (i32.const 0))
  (global $gl_stencil_height (mut i32) (i32.const 0))
  (global $rast_stencil_state (mut i32) (i32.const 0))
  (global $gl_stencil_worker_state (mut i32) (i32.const 0))

  (func $gl_stencil_release
    (call $d3dim_worker_fence)
    (if (global.get $gl_stencil_pixels)
      (then (call $heap_free (call $w2g (global.get $gl_stencil_pixels)))))
    (global.set $gl_stencil_pixels (i32.const 0))
    (global.set $gl_stencil_pitch (i32.const 0))
    (global.set $gl_stencil_height (i32.const 0)))

  (func $gl_stencil_ensure (result i32)
    (local $p i32) (local $w i32) (local $h i32)
    (if (global.get $gl_stencil_pixels) (then (return (i32.const 1))))
    (if (i32.eqz (global.get $gl_sw_rt)) (then (return (i32.const 0))))
    (local.set $w (load.field DxObject width (global.get $gl_sw_rt)))
    (local.set $h (load.field DxObject height (global.get $gl_sw_rt)))
    (local.set $p (call $gl_list_alloc (i32.mul (local.get $w) (local.get $h))))
    (if (i32.eqz (local.get $p)) (then
      (call $gl_list_error (call $gl_list_context) (i32.const 0x505))
      (return (i32.const 0))))
    (global.set $gl_stencil_pixels (local.get $p))
    (global.set $gl_stencil_pitch (local.get $w))
    (global.set $gl_stencil_height (local.get $h))
    (i32.const 1))

  (func $gl_stencil_prepare (result i32)
    (local $s i32)
    (local.set $s (call $gl_stencil_state))
    (if (local.get $s) (then
      (if (i32.load (local.get $s)) (then (return (call $gl_stencil_ensure))))))
    (i32.const 1))

  ;; Coordinates here are relative to the scissor surface view.
  (func $gl_stencil_address (param $x i32) (param $y i32) (result i32)
    (i32.add (global.get $gl_stencil_pixels)
      (i32.add (i32.mul (i32.add (local.get $y) (global.get $gl_sw_r_dy)) (global.get $gl_stencil_pitch))
        (i32.add (local.get $x) (global.get $gl_sw_r_dx)))))

  (func $gl_stencil_apply (param $p i32) (param $op i32)
    (local $s i32) (local $old i32) (local $v i32) (local $mask i32)
    (local.set $s (global.get $rast_stencil_state))
    (local.set $old (i32.load8_u (local.get $p)))
    (local.set $v (local.get $old))
    (if (i32.eqz (local.get $op)) (then (local.set $v (i32.const 0))))
    (if (i32.eq (local.get $op) (i32.const 0x1e01)) (then (local.set $v (i32.load offset=8 (local.get $s)))))
    (if (i32.eq (local.get $op) (i32.const 0x1e02)) (then
      (local.set $v (select (i32.const 255) (i32.add (local.get $old) (i32.const 1)) (i32.eq (local.get $old) (i32.const 255))))))
    (if (i32.eq (local.get $op) (i32.const 0x1e03)) (then
      (local.set $v (select (i32.sub (local.get $old) (i32.const 1)) (i32.const 0) (local.get $old)))))
    (if (i32.eq (local.get $op) (i32.const 0x150a)) (then (local.set $v (i32.xor (local.get $old) (i32.const 255)))))
    (local.set $mask (i32.load offset=16 (local.get $s)))
    (i32.store8 (local.get $p) (i32.or
      (i32.and (local.get $old) (i32.xor (local.get $mask) (i32.const -1)))
      (i32.and (local.get $v) (local.get $mask)))))

  ;; Return 0 on stencil rejection (and perform FAIL); depth stays untouched.
  (func $gl_stencil_test (param $x i32) (param $y i32) (result i32)
    (local $s i32) (local $p i32) (local $mask i32)
    (local.set $s (global.get $rast_stencil_state))
    (local.set $p (call $gl_stencil_address (local.get $x) (local.get $y)))
    (local.set $mask (i32.and (i32.load offset=12 (local.get $s)) (i32.const 255)))
    (if (call $d3dim_depth_compare_u (i32.and (i32.load offset=8 (local.get $s)) (local.get $mask))
        (i32.and (i32.load8_u (local.get $p)) (local.get $mask))
        (i32.sub (i32.load offset=4 (local.get $s)) (i32.const 0x1ff)))
      (then (return (i32.const 1))))
    (call $gl_stencil_apply (local.get $p) (i32.load offset=20 (local.get $s)))
    (i32.const 0))

  (func $gl_stencil_clear (param $rt i32)
    (local $s i32) (local $x i32) (local $y i32) (local $dx i32) (local $dy i32)
    (local $w i32) (local $h i32) (local $p i32) (local $mask i32) (local $v i32)
    (if (i32.eqz (call $gl_stencil_ensure)) (then (return)))
    (local.set $s (call $gl_stencil_state))
    (local.set $mask (i32.and (i32.load offset=16 (local.get $s)) (i32.const 255)))
    (if (i32.eqz (local.get $mask)) (then (return)))
    (local.set $v (i32.and (i32.load offset=32 (local.get $s)) (local.get $mask)))
    (if (i32.ne (local.get $rt) (global.get $gl_sw_rt)) (then
      (local.set $dx (global.get $gl_sw_sc_x)) (local.set $dy (global.get $gl_sw_sc_y))))
    (local.set $w (load.field DxObject width (local.get $rt)))
    (local.set $h (load.field DxObject height (local.get $rt)))
    (block $done (loop $rows
      (br_if $done (i32.ge_u (local.get $y) (local.get $h)))
      (local.set $x (i32.const 0))
      (block $row_done (loop $pixels
        (br_if $row_done (i32.ge_u (local.get $x) (local.get $w)))
        (local.set $p (i32.add (global.get $gl_stencil_pixels)
          (i32.add (i32.mul (i32.add (local.get $y) (local.get $dy)) (global.get $gl_stencil_pitch))
            (i32.add (local.get $x) (local.get $dx)))))
        (i32.store8 (local.get $p) (i32.or (local.get $v)
          (i32.and (i32.load8_u (local.get $p)) (i32.xor (local.get $mask) (i32.const 255)))))
        (local.set $x (i32.add (local.get $x) (i32.const 1))) (br $pixels)))
      (local.set $y (i32.add (local.get $y) (i32.const 1))) (br $rows))))

  (func $gl_stencil_init (param $s i32)
    (i32.store offset=4 (local.get $s) (i32.const 0x207))
    (i32.store offset=12 (local.get $s) (i32.const -1))
    (i32.store offset=16 (local.get $s) (i32.const -1))
    (i32.store offset=20 (local.get $s) (i32.const 0x1e00))
    (i32.store offset=24 (local.get $s) (i32.const 0x1e00))
    (i32.store offset=28 (local.get $s) (i32.const 0x1e00)))

  (func $gl_stencil_state (result i32)
    (local $ctx i32)
    (if (global.get $gl_sw_in_worker) (then (return (global.get $gl_stencil_worker_state))))
    (local.set $ctx (call $gl_list_context))
    (if (result i32) (local.get $ctx)
      (then (i32.add (local.get $ctx) (i32.const 192))) (else (i32.const 0))))

  (func $gl_stencil_op_valid (param $op i32) (result i32)
    (i32.or (i32.or (i32.eqz (local.get $op)) (i32.eq (local.get $op) (i32.const 0x150a)))
      (i32.le_u (i32.sub (local.get $op) (i32.const 0x1e00)) (i32.const 3))))

  ;; WebGL1 cannot read this attachment. Keep this unsupported transfer
  ;; explicit on both paths instead of the legacy color-read fallback.
  (func $gl_stencil_readback_unsupported (unreachable))

  ;; Validate before display-list capture, without changing execution state.
  (func $gl_stencil_validate (param $ctx i32) (param $op i32) (param $stack i32) (result i32)
    (local $a i32) (local $handled i32) (local $error i32)
    (local.set $a (i32.load offset=4 (local.get $stack)))
    (local.set $handled (i32.or (i32.eq (local.get $op) (i32.const 2))
      (i32.le_u (i32.sub (local.get $op) (i32.const 136)) (i32.const 3))))
    (if (i32.and (i32.eq (local.get $a) (i32.const 0xb90))
      (i32.or (i32.eq (local.get $op) (i32.const 8)) (i32.eq (local.get $op) (i32.const 10))))
      (then (local.set $handled (i32.const 1))))
    (if (i32.eqz (local.get $handled)) (then (return (i32.const 0))))
    (if (i32.or (i32.ge_s (global.get $gl_immediate_mode) (i32.const 0))
        (i32.ne (i32.load offset=36 (local.get $ctx)) (i32.const 0))) (then
      (call $gl_list_error (local.get $ctx) (i32.const 0x502)) (return (i32.const 1))))
    (if (i32.and (i32.eq (local.get $op) (i32.const 2))
      (i32.ne (i32.and (local.get $a) (i32.const 0xffffb8ff)) (i32.const 0)))
      (then (local.set $error (i32.const 0x501))))
    (if (i32.and (i32.eq (local.get $op) (i32.const 137))
      (i32.gt_u (i32.sub (local.get $a) (i32.const 0x200)) (i32.const 7)))
      (then (local.set $error (i32.const 0x500))))
    (if (i32.eq (local.get $op) (i32.const 138)) (then
      (if (i32.eqz (i32.and (call $gl_stencil_op_valid (local.get $a))
        (i32.and (call $gl_stencil_op_valid (i32.load offset=8 (local.get $stack)))
          (call $gl_stencil_op_valid (i32.load offset=12 (local.get $stack))))))
        (then (local.set $error (i32.const 0x500))))))
    (if (local.get $error) (then
      (call $gl_list_error (local.get $ctx) (local.get $error)) (return (i32.const 1))))
    (i32.const 0))

  (func $gl_stencil_intercept (param $op i32) (param $stack i32) (result i32)
    (local $ctx i32) (local $s i32) (local $a i32) (local $v i32) (local $n i32)
    (local $query i32) (local $handled i32)
    (local.set $ctx (call $gl_list_context))
    (if (i32.eqz (local.get $ctx)) (then (return (i32.const 0))))
    (if (i32.and (i32.eq (local.get $op) (i32.const 17))
      (i32.eq (i32.load offset=20 (local.get $stack)) (i32.const 0x1901)))
      (then (call $gl_stencil_readback_unsupported)))
    (local.set $s (i32.add (local.get $ctx) (i32.const 192)))
    (local.set $a (i32.load offset=4 (local.get $stack)))
    (local.set $v (i32.load offset=8 (local.get $stack)))
    (local.set $handled (i32.le_u (i32.sub (local.get $op) (i32.const 136)) (i32.const 3)))
    (if (i32.and (i32.eq (local.get $a) (i32.const 0xb90))
      (i32.or (i32.eq (local.get $op) (i32.const 8)) (i32.eq (local.get $op) (i32.const 10))))
      (then (local.set $handled (i32.const 1))))
    (if (local.get $handled) (then
      (if (i32.eq (local.get $op) (i32.const 137)) (then
        (i32.store offset=4 (local.get $s) (local.get $a))
        (i32.store offset=8 (local.get $s) (select (i32.const 255)
          (select (i32.const 0) (local.get $v) (i32.lt_s (local.get $v) (i32.const 0)))
          (i32.gt_s (local.get $v) (i32.const 255))))
        (i32.store offset=12 (local.get $s) (i32.load offset=12 (local.get $stack)))))
      (if (i32.eq (local.get $op) (i32.const 138)) (then
        (memory.copy (i32.add (local.get $s) (i32.const 20))
          (i32.add (local.get $stack) (i32.const 4)) (i32.const 12))))
      (if (i32.eq (local.get $op) (i32.const 136))
        (then (i32.store offset=16 (local.get $s) (local.get $a))))
      (if (i32.eq (local.get $op) (i32.const 139))
        (then (i32.store offset=32 (local.get $s) (i32.and (local.get $a) (i32.const 255)))))
      (if (i32.lt_u (local.get $op) (i32.const 136))
        (then (i32.store (local.get $s) (i32.eq (local.get $op) (i32.const 10)))))))
    (if (i32.or (i32.eq (local.get $op) (i32.const 13)) (i32.eq (local.get $op) (i32.const 103))) (then
      (local.set $query (i32.const 1))
      (local.set $n (i32.const -1))
      (if (i32.eq (local.get $a) (i32.const 0xb90)) (then (local.set $n (i32.const 0))))
      (if (i32.eq (local.get $a) (i32.const 0xb91)) (then (local.set $n (i32.const 32))))
      (if (i32.eq (local.get $a) (i32.const 0xb92)) (then (local.set $n (i32.const 4))))
      (if (i32.eq (local.get $a) (i32.const 0xb93)) (then (local.set $n (i32.const 12))))
      (if (i32.eq (local.get $a) (i32.const 0xb94)) (then (local.set $n (i32.const 20))))
      (if (i32.eq (local.get $a) (i32.const 0xb95)) (then (local.set $n (i32.const 24))))
      (if (i32.eq (local.get $a) (i32.const 0xb96)) (then (local.set $n (i32.const 28))))
      (if (i32.eq (local.get $a) (i32.const 0xb97)) (then (local.set $n (i32.const 8))))
      (if (i32.eq (local.get $a) (i32.const 0xb98)) (then (local.set $n (i32.const 16))))
      (if (i32.ge_s (local.get $n) (i32.const 0))
        (then (local.set $n (i32.load (i32.add (local.get $s) (local.get $n)))))
        (else (if (i32.eq (local.get $a) (i32.const 0xd57)) (then (local.set $n (i32.const 8)))
          (else (local.set $query (i32.const 0))))))
      (if (local.get $query) (then
        (if (i32.ge_s (global.get $gl_immediate_mode) (i32.const 0)) (then
          (call $gl_list_error (local.get $ctx) (i32.const 0x502)) (return (i32.const 1))))
        (call $gs32 (local.get $v) (if (result i32) (i32.eq (local.get $op) (i32.const 13))
          (then (i32.reinterpret_f32 (f32.convert_i32_s (local.get $n)))) (else (local.get $n))))
        (return (i32.const 1))))))
    (if (i32.and (i32.eq (local.get $op) (i32.const 65)) (i32.eq (local.get $a) (i32.const 0xb90)))
      (then
        (if (i32.ge_s (global.get $gl_immediate_mode) (i32.const 0)) (then
          (call $gl_list_error (local.get $ctx) (i32.const 0x502)) (return (i32.const 1))))
        (global.set $gl_list_result (i32.load (local.get $s))) (return (i32.const 1))))
    (i32.const 0))
