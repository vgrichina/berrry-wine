  ;; WGL outline lists are built privately, then installed in the existing
  ;; shared list namespace. No GL command executes during font construction.
  ;; Stage: slot, head, tail, error, metrics[6], edges, edge-count (48 bytes).
  ;; Edge: next, padding, x0/y0/x1/y1 as doubles (40 bytes), in em units.
  (func $wgl_outline_command (param $s i32) (param $op i32)
        (param $a i32) (param $b i32) (param $c i32)
    (local $p i32)
    (if (i32.load offset=12 (local.get $s)) (then (return)))
    (local.set $p (call $gl_list_alloc (i32.const 88)))
    (if (i32.eqz (local.get $p)) (then
      (i32.store offset=12 (local.get $s) (i32.const 8)) (return)))
    (i32.store offset=4 (local.get $p) (local.get $op))
    (i32.store offset=12 (local.get $p) (local.get $a))
    (i32.store offset=16 (local.get $p) (local.get $b))
    (i32.store offset=20 (local.get $p) (local.get $c))
    (if (i32.load offset=8 (local.get $s))
      (then (i32.store (i32.load offset=8 (local.get $s)) (local.get $p)))
      (else (i32.store offset=4 (local.get $s) (local.get $p))))
    (i32.store offset=8 (local.get $s) (local.get $p)))

  (func $wgl_outline_vector (param $s i32) (param $op i32)
        (param $x f64) (param $y f64) (param $z f64)
    (call $wgl_outline_command (local.get $s) (local.get $op)
      (i32.reinterpret_f32 (f32.demote_f64 (local.get $x)))
      (i32.reinterpret_f32 (f32.demote_f64 (local.get $y)))
      (i32.reinterpret_f32 (f32.demote_f64 (local.get $z)))))

  (func $wgl_outline_edge (param $s i32) (param $x f64) (param $y f64)
        (param $u f64) (param $v f64)
    (local $p i32)
    (if (i32.load offset=12 (local.get $s)) (then (return)))
    (if (i32.and (f64.eq (local.get $x) (local.get $u))
        (f64.eq (local.get $y) (local.get $v))) (then (return)))
    ;; Exhaustion is a failure of the entire request, never truncated geometry.
    (if (i32.ge_u (i32.load offset=44 (local.get $s)) (i32.const 1048576))
      (then (i32.store offset=12 (local.get $s) (i32.const 8)) (return)))
    (local.set $p (call $gl_list_alloc (i32.const 40)))
    (if (i32.eqz (local.get $p)) (then
      (i32.store offset=12 (local.get $s) (i32.const 8)) (return)))
    (i32.store (local.get $p) (i32.load offset=40 (local.get $s)))
    (f64.store offset=8 (local.get $p) (local.get $x))
    (f64.store offset=16 (local.get $p) (local.get $y))
    (f64.store offset=24 (local.get $p) (local.get $u))
    (f64.store offset=32 (local.get $p) (local.get $v))
    (i32.store offset=40 (local.get $s) (local.get $p))
    (i32.store offset=44 (local.get $s)
      (i32.add (i32.load offset=44 (local.get $s)) (i32.const 1))))

  ;; De Casteljau subdivision; |P0 - 2C + P1|/4 bounds chordal error.
  ;; Doubles preserve the supplied tolerance until final GL float capture.
  (func $wgl_outline_quad (param $s i32)
        (param $x f64) (param $y f64) (param $cx f64) (param $cy f64)
        (param $u f64) (param $v f64) (param $deviation f64) (param $depth i32)
    (local $dx f64) (local $dy f64) (local $mx f64) (local $my f64)
    (local.set $dx (f64.sub (f64.add (local.get $x) (local.get $u)) (f64.mul (f64.const 2) (local.get $cx))))
    (local.set $dy (f64.sub (f64.add (local.get $y) (local.get $v)) (f64.mul (f64.const 2) (local.get $cy))))
    (if (f64.le (f64.mul (f64.sqrt (f64.add (f64.mul (local.get $dx) (local.get $dx))
        (f64.mul (local.get $dy) (local.get $dy)))) (f64.const 0.25)) (local.get $deviation))
      (then (call $wgl_outline_edge (local.get $s) (local.get $x) (local.get $y) (local.get $u) (local.get $v)) (return)))
    (if (i32.ge_u (local.get $depth) (i32.const 24))
      (then (i32.store offset=12 (local.get $s) (i32.const 8)) (return)))
    (if (i32.load offset=12 (local.get $s)) (then (return)))
    (local.set $mx (f64.mul (f64.add (f64.add (local.get $x) (local.get $u))
      (f64.mul (f64.const 2) (local.get $cx))) (f64.const 0.25)))
    (local.set $my (f64.mul (f64.add (f64.add (local.get $y) (local.get $v))
      (f64.mul (f64.const 2) (local.get $cy))) (f64.const 0.25)))
    (call $wgl_outline_quad (local.get $s) (local.get $x) (local.get $y)
      (f64.mul (f64.add (local.get $x) (local.get $cx)) (f64.const 0.5))
      (f64.mul (f64.add (local.get $y) (local.get $cy)) (f64.const 0.5))
      (local.get $mx) (local.get $my) (local.get $deviation) (i32.add (local.get $depth) (i32.const 1)))
    (call $wgl_outline_quad (local.get $s) (local.get $mx) (local.get $my)
      (f64.mul (f64.add (local.get $u) (local.get $cx)) (f64.const 0.5))
      (f64.mul (f64.add (local.get $v) (local.get $cy)) (f64.const 0.5))
      (local.get $u) (local.get $v) (local.get $deviation) (i32.add (local.get $depth) (i32.const 1))))

  (func $wgl_outline_coordinate (param $p i32) (param $em f64) (result f64)
    (f64.div (f64.convert_i32_s (i32.load (local.get $p))) (f64.mul (local.get $em) (f64.const 65536))))

  ;; The existing serializer reconstructs implied points, contour closure and
  ;; composite glyphs. Request design units, without a device-size hint pass.
  (func $wgl_outline_edges (param $s i32) (param $data i32) (param $size i32)
        (param $gid i32) (param $em i32) (param $deviation f64)
    (local $points i32) (local $count i32) (local $bytes i32) (local $buffer i32)
    (local $p i32) (local $end i32) (local $q i32) (local $limit i32)
    (local $x f64) (local $y f64) (local $cx f64) (local $cy f64)
    (local $u f64) (local $v f64) (local $upem f64)
    (local.set $upem (f64.convert_i32_u (local.get $em)))
    (local.set $points (call $tt_raster_scratch (local.get $data) (local.get $size)))
    (if (i32.eqz (local.get $points))
      (then (i32.store offset=12 (local.get $s) (i32.const 8)) (return)))
    (local.set $count (call $tt_glyph_load_raster_outline (local.get $data) (local.get $size)
      (local.get $gid) (local.get $points) (global.get $TT_RASTER_POINTS) (i32.const 0)))
    (local.set $bytes (call $tt_ggo_native_bytes (local.get $points) (i32.const 0)
      (local.get $count) (local.get $em) (local.get $em) (i32.const 0) (i32.const 0)))
    (if (i32.eqz (local.get $bytes)) (then (return)))
    (local.set $buffer (call $gl_list_alloc (local.get $bytes)))
    (if (i32.eqz (local.get $buffer))
      (then (i32.store offset=12 (local.get $s) (i32.const 8)) (return)))
    (drop (call $tt_ggo_native_bytes (local.get $points) (i32.const 0)
      (local.get $count) (local.get $em) (local.get $em) (i32.const 0) (local.get $buffer)))
    (local.set $p (local.get $buffer))
    (local.set $end (i32.add (local.get $p) (local.get $bytes)))
    (block $done (loop $contours
      (br_if $done (i32.ge_u (local.get $p) (local.get $end)))
      (local.set $limit (i32.add (local.get $p) (i32.load (local.get $p))))
      (local.set $x (call $wgl_outline_coordinate (i32.add (local.get $p) (i32.const 8)) (local.get $upem)))
      (local.set $y (call $wgl_outline_coordinate (i32.add (local.get $p) (i32.const 12)) (local.get $upem)))
      (local.set $q (i32.add (local.get $p) (i32.const 16)))
      ;; Native serializer emits one line or one quadratic per record.
      (block $contour_done (loop $segments
        (br_if $contour_done (i32.ge_u (local.get $q) (local.get $limit)))
        (local.set $u (call $wgl_outline_coordinate (i32.add (local.get $q) (i32.const 4)) (local.get $upem)))
        (local.set $v (call $wgl_outline_coordinate (i32.add (local.get $q) (i32.const 8)) (local.get $upem)))
        (if (i32.eq (i32.load16_u (local.get $q)) (i32.const 2)) (then
          (local.set $cx (local.get $u)) (local.set $cy (local.get $v))
          (local.set $u (call $wgl_outline_coordinate (i32.add (local.get $q) (i32.const 12)) (local.get $upem)))
          (local.set $v (call $wgl_outline_coordinate (i32.add (local.get $q) (i32.const 16)) (local.get $upem)))
          (call $wgl_outline_quad (local.get $s) (local.get $x) (local.get $y)
            (local.get $cx) (local.get $cy) (local.get $u) (local.get $v) (local.get $deviation) (i32.const 0)))
          (else (call $wgl_outline_edge (local.get $s) (local.get $x) (local.get $y) (local.get $u) (local.get $v))))
        (local.set $x (local.get $u)) (local.set $y (local.get $v))
        (local.set $q (i32.add (local.get $q) (i32.add (i32.const 4)
          (i32.shl (i32.load16_u offset=2 (local.get $q)) (i32.const 3)))))
        (br $segments)))
      (local.set $p (local.get $limit)) (br $contours)))
    (call $heap_free (call $w2g (local.get $buffer))))

  (func $wgl_outline_edge_x (param $edge i32) (param $y f64) (result f64)
    (f64.add (f64.load offset=8 (local.get $edge))
      (f64.mul (f64.div (f64.sub (local.get $y) (f64.load offset=16 (local.get $edge)))
        (f64.sub (f64.load offset=32 (local.get $edge)) (f64.load offset=16 (local.get $edge))))
        (f64.sub (f64.load offset=24 (local.get $edge)) (f64.load offset=8 (local.get $edge))))))

  ;; A cap trapezoid, split into two CCW triangles (reverse for the back cap).
  (func $wgl_outline_trapezoid (param $s i32) (param $left i32) (param $right i32)
        (param $low f64) (param $high f64) (param $z f64) (param $back i32)
    (local $a f64) (local $b f64) (local $c f64) (local $d f64)
    (local.set $a (call $wgl_outline_edge_x (local.get $left) (local.get $low)))
    (local.set $b (call $wgl_outline_edge_x (local.get $right) (local.get $low)))
    (local.set $c (call $wgl_outline_edge_x (local.get $right) (local.get $high)))
    (local.set $d (call $wgl_outline_edge_x (local.get $left) (local.get $high)))
    (call $wgl_outline_vector (local.get $s) (i32.const 30) (local.get $a) (local.get $low) (local.get $z))
    (if (local.get $back)
      (then (call $wgl_outline_vector (local.get $s) (i32.const 30) (local.get $c) (local.get $high) (local.get $z))
        (call $wgl_outline_vector (local.get $s) (i32.const 30) (local.get $b) (local.get $low) (local.get $z)))
      (else (call $wgl_outline_vector (local.get $s) (i32.const 30) (local.get $b) (local.get $low) (local.get $z))
        (call $wgl_outline_vector (local.get $s) (i32.const 30) (local.get $c) (local.get $high) (local.get $z))))
    (call $wgl_outline_vector (local.get $s) (i32.const 30) (local.get $a) (local.get $low) (local.get $z))
    (if (local.get $back)
      (then (call $wgl_outline_vector (local.get $s) (i32.const 30) (local.get $d) (local.get $high) (local.get $z))
        (call $wgl_outline_vector (local.get $s) (i32.const 30) (local.get $c) (local.get $high) (local.get $z)))
      (else (call $wgl_outline_vector (local.get $s) (i32.const 30) (local.get $c) (local.get $high) (local.get $z))
        (call $wgl_outline_vector (local.get $s) (i32.const 30) (local.get $d) (local.get $high) (local.get $z)))))

  ;; Scan-convert *geometry*, not a raster mask. Each slab ends at the next
  ;; vertex or edge intersection. Sorted crossings and nonzero winding retain
  ;; counters, disconnected contours, overlaps and composite glyphs.
  (func $wgl_outline_caps (param $s i32) (param $z f64) (param $back i32)
    (local $head i32) (local $e i32) (local $f i32) (local $n i32) (local $i i32)
    (local $j i32) (local $crossings i32) (local $winding i32) (local $left i32)
    (local $low f64) (local $high f64) (local $mid f64) (local $y f64)
    (local $lo f64) (local $hi f64) (local $dl f64) (local $dh f64) (local $x f64)
    (local.set $head (i32.load offset=40 (local.get $s)))
    (if (i32.eqz (local.get $head)) (then (return)))
    (local.set $crossings (call $gl_list_alloc (i32.mul (i32.load offset=44 (local.get $s)) (i32.const 4))))
    (if (i32.eqz (local.get $crossings))
      (then (i32.store offset=12 (local.get $s) (i32.const 8)) (return)))
    (local.set $low (f64.const inf))
    (local.set $e (local.get $head))
    (loop $minimum
      (local.set $low (f64.min (local.get $low) (f64.min
        (f64.load offset=16 (local.get $e)) (f64.load offset=32 (local.get $e)))))
      (local.set $e (i32.load (local.get $e))) (br_if $minimum (local.get $e)))
    (call $wgl_outline_vector (local.get $s) (i32.const 63) (f64.const 0) (f64.const 0)
      (select (f64.const -1) (f64.const 1) (local.get $back)))
    (call $wgl_outline_command (local.get $s) (i32.const 21) (i32.const 4) (i32.const 0) (i32.const 0))
    (block $done (loop $slabs
      (br_if $done (i32.load offset=12 (local.get $s)))
      (local.set $high (f64.const inf)) (local.set $e (local.get $head))
      (loop $next_vertex
        (local.set $y (f64.load offset=16 (local.get $e)))
        (if (f64.gt (local.get $y) (local.get $low)) (then (local.set $high (f64.min (local.get $high) (local.get $y)))))
        (local.set $y (f64.load offset=32 (local.get $e)))
        (if (f64.gt (local.get $y) (local.get $low)) (then (local.set $high (f64.min (local.get $high) (local.get $y)))))
        (local.set $e (i32.load (local.get $e))) (br_if $next_vertex (local.get $e)))
      (br_if $done (f64.eq (local.get $high) (f64.const inf)))
      ;; Split at interior crossings too; vertex-only slabs misfill overlaps.
      (local.set $e (local.get $head))
      (loop $pairs
        (local.set $f (i32.load (local.get $e)))
        (block $pairs_done (loop $pair
          (br_if $pairs_done (i32.eqz (local.get $f)))
          ;; Compute each intersection from immutable endpoints, so revisiting
          ;; it in a later slab gives exactly the same event coordinate.
          (local.set $lo (f64.max
            (f64.min (f64.load offset=16 (local.get $e)) (f64.load offset=32 (local.get $e)))
            (f64.min (f64.load offset=16 (local.get $f)) (f64.load offset=32 (local.get $f)))))
          (local.set $hi (f64.min
            (f64.max (f64.load offset=16 (local.get $e)) (f64.load offset=32 (local.get $e)))
            (f64.max (f64.load offset=16 (local.get $f)) (f64.load offset=32 (local.get $f)))))
          (if (f64.lt (local.get $lo) (local.get $hi)) (then
            (local.set $dl (f64.sub (call $wgl_outline_edge_x (local.get $e) (local.get $lo))
              (call $wgl_outline_edge_x (local.get $f) (local.get $lo))))
            (local.set $dh (f64.sub (call $wgl_outline_edge_x (local.get $e) (local.get $hi))
              (call $wgl_outline_edge_x (local.get $f) (local.get $hi))))
            (if (f64.lt (f64.mul (local.get $dl) (local.get $dh)) (f64.const 0)) (then
              (local.set $y (f64.add (local.get $lo) (f64.mul (f64.sub (local.get $hi) (local.get $lo))
                (f64.div (local.get $dl) (f64.sub (local.get $dl) (local.get $dh))))))
              (if (f64.gt (local.get $y) (local.get $low))
                (then (local.set $high (f64.min (local.get $high) (local.get $y)))))))))
          (local.set $f (i32.load (local.get $f))) (br $pair)))
        (local.set $e (i32.load (local.get $e))) (br_if $pairs (local.get $e)))
      (local.set $mid (f64.mul (f64.add (local.get $low) (local.get $high)) (f64.const 0.5)))
      (local.set $n (i32.const 0)) (local.set $e (local.get $head))
      (loop $sort_crossings
        (if (i32.and (f64.lt (f64.min (f64.load offset=16 (local.get $e)) (f64.load offset=32 (local.get $e))) (local.get $mid))
            (f64.gt (f64.max (f64.load offset=16 (local.get $e)) (f64.load offset=32 (local.get $e))) (local.get $mid))) (then
          (local.set $x (call $wgl_outline_edge_x (local.get $e) (local.get $mid)))
          (local.set $j (local.get $n))
          (block $insert (loop $shift
            (br_if $insert (i32.eqz (local.get $j)))
            (local.set $f (i32.load (i32.add (local.get $crossings) (i32.shl (i32.sub (local.get $j) (i32.const 1)) (i32.const 2)))))
            (br_if $insert (f64.le (call $wgl_outline_edge_x (local.get $f) (local.get $mid)) (local.get $x)))
            (i32.store (i32.add (local.get $crossings) (i32.shl (local.get $j) (i32.const 2))) (local.get $f))
            (local.set $j (i32.sub (local.get $j) (i32.const 1))) (br $shift)))
          (i32.store (i32.add (local.get $crossings) (i32.shl (local.get $j) (i32.const 2))) (local.get $e))
          (local.set $n (i32.add (local.get $n) (i32.const 1)))))
        (local.set $e (i32.load (local.get $e))) (br_if $sort_crossings (local.get $e)))
      (local.set $i (i32.const 0)) (local.set $winding (i32.const 0))
      (block $crossings_done (loop $fill
        (br_if $crossings_done (i32.ge_u (local.get $i) (local.get $n)))
        (local.set $e (i32.load (i32.add (local.get $crossings) (i32.shl (local.get $i) (i32.const 2)))))
        (if (i32.eqz (local.get $winding)) (then (local.set $left (local.get $e))))
        (local.set $winding (i32.add (local.get $winding) (select (i32.const 1) (i32.const -1)
          (f64.gt (f64.load offset=32 (local.get $e)) (f64.load offset=16 (local.get $e))))))
        (if (i32.eqz (local.get $winding)) (then
          (call $wgl_outline_trapezoid (local.get $s) (local.get $left) (local.get $e)
            (local.get $low) (local.get $high) (local.get $z) (local.get $back))))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $fill)))
      (local.set $low (local.get $high)) (br $slabs)))
    (call $wgl_outline_command (local.get $s) (i32.const 22) (i32.const 0) (i32.const 0) (i32.const 0))
    (call $heap_free (call $w2g (local.get $crossings))))

  (func $wgl_outline_geometry (param $s i32) (param $format i32) (param $extrusion f64)
    (local $e i32) (local $next i32) (local $x f64) (local $y f64)
    (local $u f64) (local $v f64) (local $dx f64) (local $dy f64) (local $len f64)
    (local $z f64)
    (local.set $z (f64.neg (local.get $extrusion)))
    (if (local.get $format) (then
      (call $wgl_outline_command (local.get $s) (i32.const 81) (i32.const 0x901) (i32.const 0) (i32.const 0))
      (call $wgl_outline_caps (local.get $s) (f64.const 0) (i32.const 0))
      (if (f64.gt (local.get $extrusion) (f64.const 0))
        (then (call $wgl_outline_caps (local.get $s) (local.get $z) (i32.const 1))))))
    (if (i32.or (i32.eqz (local.get $format)) (f64.gt (local.get $extrusion) (f64.const 0))) (then
      (call $wgl_outline_command (local.get $s) (i32.const 21)
        (select (i32.const 7) (i32.const 1) (local.get $format)) (i32.const 0) (i32.const 0))
      (local.set $e (i32.load offset=40 (local.get $s)))
      (block $done (loop $edges
        (br_if $done (i32.eqz (local.get $e)))
        (local.set $x (f64.load offset=8 (local.get $e)))
        (local.set $y (f64.load offset=16 (local.get $e)))
        (local.set $u (f64.load offset=24 (local.get $e)))
        (local.set $v (f64.load offset=32 (local.get $e)))
        (if (local.get $format) (then
          ;; TrueType outer contours are clockwise, holes counterclockwise;
          ;; their left normal points out of the extruded solid in both cases.
          (local.set $dx (f64.sub (local.get $u) (local.get $x)))
          (local.set $dy (f64.sub (local.get $v) (local.get $y)))
          (local.set $len (f64.sqrt (f64.add (f64.mul (local.get $dx) (local.get $dx))
            (f64.mul (local.get $dy) (local.get $dy)))))
          (call $wgl_outline_vector (local.get $s) (i32.const 63)
            (f64.div (f64.neg (local.get $dy)) (local.get $len))
            (f64.div (local.get $dx) (local.get $len)) (f64.const 0))))
        (call $wgl_outline_vector (local.get $s) (i32.const 30) (local.get $x) (local.get $y) (f64.const 0))
        (call $wgl_outline_vector (local.get $s) (i32.const 30) (local.get $u) (local.get $v) (f64.const 0))
        (if (f64.gt (local.get $extrusion) (f64.const 0)) (then
          (call $wgl_outline_vector (local.get $s) (i32.const 30) (local.get $u) (local.get $v) (local.get $z))
