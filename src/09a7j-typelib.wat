(local.set $hr (call $tl_invoke (local.get $arg1) (local.get $arg0) (local.get $arg2) (local.get $arg3) (local.get $arg4)
 (call $gl32 (i32.add (local.get $sp) (i32.const 24))) (call $gl32 (i32.add (local.get $sp) (i32.const 28))) (call $gl32 (i32.add (local.get $sp) (i32.const 32)))))
(if (i32.eq (local.get $hr) (i32.const 1)) (then (return)))
(i32.store offset=0 (global.get $reg_base) (local.get $hr))
(i32.store offset=16 (global.get $reg_base) (i32.add (i32.load offset=16 (global.get $reg_base)) (i32.const 36)))
)
