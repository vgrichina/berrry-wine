    (i32.store (i32.add (global.get $THUNK_BASE) (i32.mul (global.get $num_thunks) (i32.const 8)))
      (i32.const 0xCACA0007))
    (global.set $num_thunks (i32.add (global.get $num_thunks) (i32.const 1)))

