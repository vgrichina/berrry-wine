  ;; kind=0 double, 1 float, 2 integer, 3 boolean.
  (func $gl_eval_write (param $out i32) (param $kind i32) (param $v f64)
    (local $raw i64) (local $i i32)
    (if (i32.eq (local.get $kind) (i32.const 0)) (then (local.set $raw (i64.reinterpret_f64 (local.get $v))))
    (else (if (i32.eq (local.get $kind) (i32.const 1)) (then
      (local.set $raw (i64.extend_i32_u (i32.reinterpret_f32 (f32.demote_f64 (local.get $v))))))
    (else (if (i32.eq (local.get $kind) (i32.const 2)) (then
      (local.set $raw (i64.extend_i32_u (i32.trunc_sat_f64_s (f64.nearest (local.get $v))))))
      (else (local.set $raw (i64.extend_i32_u (f64.ne (local.get $v) (f64.const 0))))))))))
    (loop $bytes
      (i32.store8 (call $g2w (i32.add (local.get $out) (local.get $i))) (i32.wrap_i64 (i64.shr_u (local.get $raw) (i64.extend_i32_u (i32.shl (local.get $i) (i32.const 3))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $bytes (i32.lt_u (local.get $i) (select (i32.const 8) (select (i32.const 1) (i32.const 4) (i32.eq (local.get $kind) (i32.const 3))) (i32.eqz (local.get $kind)))))))

  (func $gl_eval_query (param $op i32) (param $s i32) (result i32)
    (local $ctx i32) (local $p i32) (local $index i32) (local $state i32)
