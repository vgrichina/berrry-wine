      (local.set $out (i32.add (local.get $out) (select (i32.const 8) (select (i32.const 1) (i32.const 4) (i32.eq (local.get $kind) (i32.const 3))) (i32.eqz (local.get $kind)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br_if $values (i32.lt_u (local.get $i) (local.get $n))))
    (i32.const 1))
  (func $gl_eval_enable (param $op i32) (param $s i32) (result i32)
    (local $index i32) (local $state i32) (local $bit i32)
    (if (i32.eqz (global.get $gl_current_context)) (then (return (i32.const 0))))
    (if (i32.eqz (i32.or (i32.eq (local.get $op) (i32.const 8)) (i32.eq (local.get $op) (i32.const 10)))) (then (return (i32.const 0))))
    (local.set $index (call $gl_eval_index (i32.load offset=4 (local.get $s))))
    (if (i32.lt_s (local.get $index) (i32.const 0)) (then (return (i32.const 0))))
    (local.set $state (call $gl_eval_state (call $gl_list_context))) (local.set $bit (i32.shl (i32.const 1) (local.get $index)))
    (i32.store (local.get $state) (if (result i32) (i32.eq (local.get $op) (i32.const 10))
      (then (i32.or (i32.load (local.get $state)) (local.get $bit)))
      (else (i32.and (i32.load (local.get $state)) (i32.xor (local.get $bit) (i32.const -1))))))
    (i32.const 1))

  (func $gl_eval_getmap (param $ctx i32) (param $s i32) (param $kind i32)
    (local $index i32) (local $query i32) (local $out i32) (local $m i32) (local $n i32) (local $i i32) (local $v f64)
    (local.set $index (call $gl_eval_index (i32.load offset=4 (local.get $s))))
    (local.set $query (i32.load offset=8 (local.get $s))) (local.set $out (i32.load offset=12 (local.get $s)))
    (if (i32.or (i32.gt_u (local.get $index) (i32.const 17)) (i32.gt_u (i32.sub (local.get $query) (i32.const 0xa00)) (i32.const 2))) (then
      (call $gl_list_error (local.get $ctx) (i32.const 0x500)) (return)))
    (local.set $m (call $gl_eval_map (call $gl_eval_state (local.get $ctx)) (local.get $index)))
    (local.set $n (select (i32.const 2) (i32.const 1) (i32.ge_u (local.get $index) (i32.const 9))))
    (if (i32.eq (local.get $query) (i32.const 0xa02)) (then (local.set $n (i32.shl (local.get $n) (i32.const 1)))))
    (if (i32.eq (local.get $query) (i32.const 0xa00)) (then
