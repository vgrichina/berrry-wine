      (local.set $nu (i32.load offset=40 (local.get $s))) (local.set $nv (i32.load offset=44 (local.get $s)))
      (if (i32.or (i32.or (i32.gt_u (i32.sub (local.get $nu) (i32.const 1)) (i32.const 7)) (i32.gt_u (i32.sub (local.get $nv) (i32.const 1)) (i32.const 7)))
        (i32.or (i32.or (i32.lt_s (local.get $us) (local.get $k)) (i32.lt_s (local.get $vs) (local.get $k)))
          (i32.or (f64.eq (f64.load offset=8 (local.get $s)) (f64.load offset=16 (local.get $s))) (f64.eq (f64.load offset=24 (local.get $s)) (f64.load offset=32 (local.get $s)))))) (then
        (call $gl_list_error (local.get $ctx) (i32.const 0x501)) (return)))
