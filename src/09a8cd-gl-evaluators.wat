    (local.set $out (i32.load offset=8 (local.get $s)))
    (local.set $kind (if (result i32) (i32.eq (local.get $op) (i32.const 145)) (then (i32.const 0))
      (else (if (result i32) (i32.eq (local.get $op) (i32.const 13)) (then (i32.const 1))
        (else (select (i32.const 3) (i32.const 2) (i32.eq (local.get $op) (i32.const 161))))))))
    (local.set $n (i32.const 1))
    (if (i32.eq (local.get $p) (i32.const 0xdd0)) (then (local.set $n (i32.const 2))))
    (if (i32.eq (local.get $p) (i32.const 0xdd2)) (then (local.set $n (i32.const 4))))
    (if (i32.eq (local.get $p) (i32.const 0xdd3)) (then (local.set $n (i32.const 2))))
    (call $gl_texcoord_check (local.get $out) (i32.mul (local.get $n) (select (i32.const 8) (select (i32.const 1) (i32.const 4) (i32.eq (local.get $kind) (i32.const 3))) (i32.eqz (local.get $kind)))))
