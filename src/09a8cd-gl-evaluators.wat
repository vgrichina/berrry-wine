    (if (i32.or (i32.eq (local.get $op) (i32.const 8)) (i32.eq (local.get $op) (i32.const 10))) (then
      (if (i32.lt_s (local.get $index) (i32.const 0)) (then (return (i32.const 0))))
      (if (i32.or (i32.ge_s (global.get $gl_immediate_mode) (i32.const 0)) (i32.load offset=36 (local.get $ctx))) (then
        (call $gl_list_error (local.get $ctx) (i32.const 0x502)) (return (i32.const 1))))
      (return (i32.const 0))))
    (if (i32.eq (local.get $op) (i32.const 65)) (then
      (if (i32.lt_s (local.get $index) (i32.const 0)) (then (return (i32.const 0))))
      (if (i32.ge_s (global.get $gl_immediate_mode) (i32.const 0)) (then
        (call $gl_list_error (local.get $ctx) (i32.const 0x502)) (return (i32.const 1))))
      (global.set $gl_list_result (i32.and (i32.shr_u (i32.load (call $gl_eval_state (local.get $ctx))) (local.get $index)) (i32.const 1)))
      (return (i32.const 1))))
    (if (i32.eqz (i32.or (i32.or (i32.eq (local.get $op) (i32.const 13)) (i32.eq (local.get $op) (i32.const 103)))
      (i32.or (i32.eq (local.get $op) (i32.const 145)) (i32.eq (local.get $op) (i32.const 161))))) (then (return (i32.const 0))))
    (if (i32.and (i32.lt_s (local.get $index) (i32.const 0))
      (i32.and (i32.ne (local.get $p) (i32.const 0xd30)) (i32.gt_u (i32.sub (local.get $p) (i32.const 0xdd0)) (i32.const 3)))) (then (return (i32.const 0))))
    (if (i32.ge_s (global.get $gl_immediate_mode) (i32.const 0)) (then
      (call $gl_list_error (local.get $ctx) (i32.const 0x502)) (return (i32.const 1))))
