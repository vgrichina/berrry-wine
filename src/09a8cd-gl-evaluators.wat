      (if (i32.gt_u (i32.sub (i32.load offset=8 (local.get $s)) (i32.const 0x1b00)) (local.get $dim)) (then
        (call $gl_list_error (local.get $ctx) (i32.const 0x500)) (return)))))
    (call $gl_eval_record (local.get $ctx) (local.get $op) (local.get $s)
      (select (i32.const 2112) (i32.const 48) (i32.eq (local.get $op) (i32.const 0x10010)))))
