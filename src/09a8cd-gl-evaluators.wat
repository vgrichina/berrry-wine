    (if (i32.eqz (global.get $gl_current_context)) (then (return (i32.const 0))))
    (local.set $p (i32.load offset=4 (local.get $s))) (local.set $index (call $gl_eval_index (local.get $p)))
    (local.set $ctx (call $gl_list_context))
    ;; Reject attribute-stack operations before any evaluator or ordinary
    ;; server-state frame can be changed, including a compiled Begin/End.
    (if (i32.or (i32.eq (local.get $op) (i32.const 76)) (i32.eq (local.get $op) (i32.const 77))) (then
      (if (i32.or (i32.ge_s (global.get $gl_immediate_mode) (i32.const 0)) (i32.ne (i32.load offset=36 (local.get $ctx)) (i32.const 0))) (then
        (call $gl_list_error (local.get $ctx) (i32.const 0x502)) (return (i32.const 1))))
