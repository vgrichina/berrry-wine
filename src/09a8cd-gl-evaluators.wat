              (i64.mul (i64.add (i64.add (i64.mul (i64.extend_i32_u (local.get $i)) (i64.extend_i32_u (local.get $us)))
                (i64.mul (i64.extend_i32_u (local.get $j)) (i64.extend_i32_u (local.get $vs)))) (i64.extend_i32_u (local.get $c)))
                (select (i64.const 8) (i64.const 4) (local.get $double)))))
            (if (i64.gt_u (local.get $address) (select (i64.const 4294967288) (i64.const 4294967292) (local.get $double))) (then (unreachable)))
            (call $gl_texcoord_check (i32.wrap_i64 (local.get $address)) (select (i32.const 8) (i32.const 4) (local.get $double)))
            (local.set $dst (i32.add (local.get $s) (i32.add (i32.const 48) (i32.shl
              (i32.add (i32.mul (i32.add (i32.mul (local.get $i) (local.get $nv)) (local.get $j)) (local.get $k)) (local.get $c)) (i32.const 3)))))
            (f64.store (local.get $dst) (call $gl_eval_read (i32.wrap_i64 (local.get $address)) (local.get $double)))
            (local.set $c (i32.add (local.get $c) (i32.const 1))) (br_if $components (i32.lt_u (local.get $c) (local.get $k))))
          (local.set $j (i32.add (local.get $j) (i32.const 1))) (br_if $cols (i32.lt_u (local.get $j) (local.get $nv))))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br_if $rows (i32.lt_u (local.get $i) (local.get $nu))))))
