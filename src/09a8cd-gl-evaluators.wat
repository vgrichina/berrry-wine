      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br_if $get (i32.lt_u (local.get $i) (local.get $n)))))

  (func $gl_eval_submit (param $op i32) (param $s i32) (param $dim i32)
    (param $us i32) (param $vs i32) (param $points i32) (param $double i32)
    (local $ctx i32) (local $index i32) (local $k i32) (local $nu i32) (local $nv i32)
    (local $i i32) (local $j i32) (local $c i32) (local $address i64) (local $dst i32)
    (if (i32.eqz (global.get $gl_current_context)) (then (return)))
