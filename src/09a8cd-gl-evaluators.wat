      (if (i32.or (i32.eq (local.get $p) (i32.const 0xdd0)) (i32.eq (local.get $p) (i32.const 0xdd2))) (then
        (local.set $g (i32.add (local.get $state) (select (i32.const 48) (i32.const 8) (i32.eq (local.get $p) (i32.const 0xdd2)))))
        (local.set $v (f64.load (i32.add (local.get $g) (i32.add (i32.const 8) (i32.shl (local.get $i) (i32.const 3))))))))
      (if (i32.or (i32.eq (local.get $p) (i32.const 0xdd1)) (i32.eq (local.get $p) (i32.const 0xdd3))) (then
        (local.set $g (i32.add (local.get $state) (select (i32.const 48) (i32.const 8) (i32.eq (local.get $p) (i32.const 0xdd3)))))
        (local.set $v (f64.convert_i32_s (i32.load (i32.add (local.get $g) (i32.shl (local.get $i) (i32.const 2))))))))
