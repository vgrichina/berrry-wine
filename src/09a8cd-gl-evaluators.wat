  ;; Canonical private commands: 0x10010 map, 11 grid, 12 coord, 13 point,
  ;; 14 mesh. aux is not transported: dimension lives in the owned record.
  ;; Record +0 unused return address, +4 dimension for non-map commands.
  (func $gl_eval_execute (param $op i32) (param $s i32)
