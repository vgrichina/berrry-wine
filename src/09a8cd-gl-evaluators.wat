      (if (i32.or (i32.ge_s (global.get $gl_immediate_mode) (i32.const 0)) (i32.and
        (i32.ne (local.get $op) (i32.const 0x10015)) (i32.ne (i32.load offset=36 (local.get $ctx)) (i32.const 0)))) (then
        (call $gl_list_error (local.get $ctx) (i32.const 0x502)) (return)))))
