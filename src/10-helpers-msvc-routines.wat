  ;; ============================================================
  ;; MSVC CRT memcpy / memmove AS NATIVE WAT (known routines, handler 396)
  ;; ============================================================
  ;; docs/design/known-routine-framework.md section 13, entries 4 and 6. The
  ;; static CRT memcpy/memmove an MSVC-linked image carries is recognised at a
  ;; block entry by its WHOLE body and run as one native memmove plus the exact
  ;; exit state the body would have left. Off unless the mask asks for it
  ;; (13-exports-style set_known_routines(mask), bit = entry id; CLI
  ;; --known-routines=MASK, browser ?known-routines=MASK).
  ;;
  ;; Matching. tools/known-routines.json names a reference body per entry; the
  ;; generated block below (`node tools/kr-sig.js wat`, --check in the build)
  ;; compares the first 16 bytes, then every absolute in-body address (the
  ;; jump tables and the `jmp [table+r*4]` operands) against entry + its offset,
  ;; then an FNV-1a over every other byte. So a body matches at any load address,
  ;; relocated or not, and in any module; one byte different anywhere declines.
  ;; The bodies call nothing, so there are no callee checks.
  ;;   1 memcpy msvc6  (GTA2, StarCraft)       2 memcpy msvc7.1 (Black & White 2)
  ;;   3 memmove msvc4 (Heroes II, its MSS32/SMACKW32)
  ;; 1 and 2 share the native form (vc6): they differ only in a lead copy's
  ;; `inc` vs `add r,1`, whose flags the next CMP overwrites.
  ;;
  ;; The block. $kr_emit (07-decoder, after the Delphi hook) emits handler 396
  ;; (operand = id, one word = entry EIP) then the body's RET, with a page-index
  ;; cover of the first instruction only (`push ebp`), as the Delphi fold does:
  ;; a fallback resumes at entry+1 and a whole-body cover would retire around
  ;; it. The whole body is registered for code-write invalidation instead
  ;; ($kr_reg; a guest store into it drops its pages, $kr_code_write from
  ;; 04-cache $invalidate_code_range), so the next entry re-decodes and
  ;; re-checks the signature. The uop compiler (07e) exits to an entry rather
  ;; than lowering it ($kr_at).
  ;;
  ;; Exactness. Native only when the whole call can finish: DF clear (the body
  ;; assumes it), no wrapped end, the stack words it pushes and reads, the
  ;; source and the destination each one proven contiguous mapping, the
  ;; destination clear of those stack words and of the body itself, no locked
  ;; lazy GPU surface under either span, none of the per-element observers
  ;; armed (--rep-store-step, native-store sessions, selective watches,
  ;; fault mode 3), and under the branch clock a budget that covers the path.
  ;; Every check is made before anything is written. Otherwise the handler
  ;; performs `push ebp` and the guest body runs from entry+1 -- the precise
  ;; instruction boundary a decline resumes at; nothing else was written.
  ;; Reproduced: memory (the n bytes, as memmove: every path of both bodies
  ;; copies in the direction that makes the overlap safe, and the stack words
  ;; the three pushes leave below ESP), all eight GPRs, EIP, DF and the flags,
  ;; per path. A path is one of the bodies' straight-line routes (direction x
  ;; alignment x lead x size class); $kr_vc6 / $kr_vc4 name it, and the clock
  ;; charge per (entry, path) is generated by tools/kr-clock.js from the
  ;; interpreter's own block counts, never written by hand.

  (global $known_routines (mut i32) (i32.const 0))
  (global $kr_cover_end (mut i32) (i32.const 0))
  ;; the path the last native call took (tools/kr-clock.js reads it)
  (global $kr_last_path (mut i32) (i32.const -1))
  ;; counters (known_routine_stat): native, fallback, SMC group drops, per id
  (global $kr_native (mut i32) (i32.const 0))
  (global $kr_fallback (mut i32) (i32.const 0))
  (global $kr_smc_drops (mut i32) (i32.const 0))
  (global $kr_bytes (mut i64) (i64.const 0))
  (global $kr_n1 (mut i32) (i32.const 0)) (global $kr_n2 (mut i32) (i32.const 0)) (global $kr_n3 (mut i32) (i32.const 0))
  (global $kr_f1 (mut i32) (i32.const 0)) (global $kr_f2 (mut i32) (i32.const 0)) (global $kr_f3 (mut i32) (i32.const 0))
  (global $kr_n4 (mut i32) (i32.const 0)) (global $kr_f4 (mut i32) (i32.const 0))
  ;; loop trips of the last native call's path (strcmp's dword loop; 0 for the
  ;; copies): its charge is base + slope x trips, both generated
  (global $kr_last_iters (mut i32) (i32.const 0))

  ;; FNV-1a over body bytes [a, b) of the body at $ga.
