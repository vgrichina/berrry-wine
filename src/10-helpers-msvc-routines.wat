  ;; ---- paths ---------------------------------------------------------------
  ;; A path plan: the exit ECX/EDX and the last flag-setting instruction
  ;; (kind 0 SUB a,b / 1 ADD a,b / 2 SHR a,2), set by $kr_vc6 / $kr_vc4,
  ;; which answer the path id.
  (global $kr_p_ecx (mut i32) (i32.const 0))
  (global $kr_p_edx (mut i32) (i32.const 0))
  (global $kr_p_fk (mut i32) (i32.const 0))
  (global $kr_p_fa (mut i32) (i32.const 0))
  (global $kr_p_fb (mut i32) (i32.const 0))
  (global $kr_p_eax (mut i32) (i32.const 0))

  ;; VC7.1 static strcmp (entry 4). No stores, no stack writes: the exit is
  ;; EAX (0, or 1 - 2*CF of the first unequal byte pair, unsigned), ECX/EDX
  ;; where the body left them, and the flags of its last flag-setting
  ;; instruction (`xor eax,eax` -> logic 0; `add eax,1` after sbb/shl). The
  ;; body: s1 = EDX. An odd s1 compares one byte (H1: edx+1 first, ecx+1 only
  ;; past an equal non-NUL byte); s1&3 = 1 then, or 2 from the start, two
  ;; bytes (H2: edx+2 first, ecx+2 at the end); then the aligned loop: four
  ;; bytes a trip, both pointers +4 only after the fourth compare, so a fourth
  ;; byte NUL exits with them advanced. Path = (s1&3)*16 + exit site (0/1 H1
  ;; unequal/NUL, 2..5 H2 byte x unequal/NUL, 6..13 loop byte x unequal/NUL);
  ;; $kr_last_iters = completed loop trips. Reads go a page at a time; a page
  ;; that is not plain guest memory (unmapped, the lazy GPU surface) declines
  ;; with nothing written, and the body then faults or reads exactly.
  (func $kr_strcmp (param $s1 i32) (param $s2 i32) (result i32)
    (local $k i32) (local $lim i32) (local $w1 i32) (local $w2 i32) (local $p1 i32) (local $p2 i32)
    (local $r1 i32) (local $r2 i32) (local $b1 i32) (local $b2 i32) (local $ne i32)
    (local $a i32) (local $k0 i32) (local $j i32) (local $ex i32) (local $edx i32) (local $ecx i32)
    (block $out
      (loop $l
        (if (i32.eq (local.get $k) (local.get $lim))
          (then
            ;; strings past 16 MB, or wrapping, are left to the body
            (if (i32.ge_u (local.get $k) (i32.const 0x1000000)) (then (return (i32.const -1))))
            (local.set $p1 (i32.add (local.get $s1) (local.get $k)))
            (local.set $p2 (i32.add (local.get $s2) (local.get $k)))
            (if (i32.or (i32.lt_u (local.get $p1) (local.get $s1)) (i32.lt_u (local.get $p2) (local.get $s2)))
              (then (return (i32.const -1))))
            (local.set $r1 (i32.sub (i32.const 0x1000) (i32.and (local.get $p1) (i32.const 0xFFF))))
            (local.set $r2 (i32.sub (i32.const 0x1000) (i32.and (local.get $p2) (i32.const 0xFFF))))
            (if (i32.eqz (call $string_guest_range_contiguous (local.get $p1) (local.get $r1))) (then (return (i32.const -1))))
            (if (i32.eqz (call $string_guest_range_contiguous (local.get $p2) (local.get $r2))) (then (return (i32.const -1))))
            (if (i32.or (call $kr_gps (local.get $p1) (local.get $r1)) (call $kr_gps (local.get $p2) (local.get $r2)))
              (then (return (i32.const -1))))
            (local.set $w1 (i32.sub (call $g2w (local.get $p1)) (local.get $k)))
            (local.set $w2 (i32.sub (call $g2w (local.get $p2)) (local.get $k)))
            (local.set $lim (i32.add (local.get $k)
              (select (local.get $r1) (local.get $r2) (i32.lt_u (local.get $r1) (local.get $r2)))))))
        (local.set $b1 (i32.load8_u (i32.add (local.get $w1) (local.get $k))))
        (local.set $b2 (i32.load8_u (i32.add (local.get $w2) (local.get $k))))
        (local.set $ne (i32.ne (local.get $b1) (local.get $b2)))
        (br_if $out (local.get $ne))
        (br_if $out (i32.eqz (local.get $b1)))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $l)))
    ;; k = the deciding byte; $ne: unequal (D) or both NUL (E)
    (global.set $kr_p_eax (select (i32.sub (i32.const 1) (i32.shl (i32.lt_u (local.get $b1) (local.get $b2)) (i32.const 1)))
                                  (i32.const 0) (local.get $ne)))
    (global.set $kr_last_iters (i32.const 0))
    (local.set $a (i32.and (local.get $s1) (i32.const 3)))
    (block $exit
      (block $head
        (local.set $k0 (i32.const 0))
        (local.set $edx (local.get $s1)) (local.set $ecx (local.get $s2))
        (br_if $head (i32.eqz (local.get $a)))
        ;; H1 (s1&3 = 1 or 3)
        (if (i32.and (local.get $a) (i32.const 1))
          (then
            (if (i32.eqz (local.get $k))
              (then
                (local.set $edx (i32.add (local.get $s1) (i32.const 1)))
                (local.set $ecx (i32.add (local.get $s2) (i32.xor (local.get $ne) (i32.const 1))))
                (local.set $ex (i32.xor (local.get $ne) (i32.const 1)))
                (br $exit)))
            (local.set $k0 (i32.const 1))
            (local.set $edx (i32.add (local.get $s1) (i32.const 1))) (local.set $ecx (i32.add (local.get $s2) (i32.const 1)))
            (br_if $head (i32.eq (local.get $a) (i32.const 3)))))
        ;; H2 at (edx, ecx): two bytes k0, k0+1
        (if (i32.le_u (local.get $k) (i32.add (local.get $k0) (i32.const 1)))
          (then
            (local.set $ex (i32.add (i32.const 2)
              (i32.add (i32.shl (i32.sub (local.get $k) (local.get $k0)) (i32.const 1)) (i32.xor (local.get $ne) (i32.const 1)))))
            (local.set $edx (i32.add (local.get $edx) (i32.const 2)))
            (br $exit)))
        (local.set $k0 (i32.add (local.get $k0) (i32.const 2)))
        (local.set $edx (i32.add (local.get $edx) (i32.const 2))) (local.set $ecx (i32.add (local.get $ecx) (i32.const 2))))
      ;; the aligned loop from byte k0 at (edx, ecx)
      (local.set $j (i32.sub (local.get $k) (local.get $k0)))
      (global.set $kr_last_iters (i32.shr_u (local.get $j) (i32.const 2)))
      (local.set $edx (i32.add (local.get $edx) (i32.and (local.get $j) (i32.const -4))))
      (local.set $ecx (i32.add (local.get $ecx) (i32.and (local.get $j) (i32.const -4))))
      (local.set $ex (i32.add (i32.const 6)
        (i32.add (i32.shl (i32.and (local.get $j) (i32.const 3)) (i32.const 1)) (i32.xor (local.get $ne) (i32.const 1)))))
      (if (i32.eq (local.get $ex) (i32.const 13))
        (then (local.set $edx (i32.add (local.get $edx) (i32.const 4))) (local.set $ecx (i32.add (local.get $ecx) (i32.const 4))))))
    (call $kr_strcmp_exit (local.get $a) (local.get $ex) (local.get $edx) (local.get $ecx) (local.get $ne)))
  (func $kr_strcmp_exit (param $a i32) (param $ex i32) (param $edx i32) (param $ecx i32) (param $ne i32) (result i32)
    (global.set $kr_p_edx (local.get $edx))
    (global.set $kr_p_ecx (local.get $ecx))
    ;; flags: unequal = ADD (eax_before, 1) with eax_before = -2*CF; equal = logic 0
    (global.set $kr_p_fk (select (i32.const 1) (i32.const 3) (local.get $ne)))
    (global.set $kr_p_fa (i32.sub (global.get $kr_p_eax) (i32.const 1)))
    (global.set $kr_p_fb (i32.const 1))
    (i32.add (i32.shl (local.get $a) (i32.const 4)) (local.get $ex)))

  (func $kr_plan (param $ecx i32) (param $edx i32) (param $fk i32) (param $fa i32) (param $fb i32)
    (global.set $kr_p_ecx (local.get $ecx)) (global.set $kr_p_edx (local.get $edx))
    (global.set $kr_p_fk (local.get $fk)) (global.set $kr_p_fa (local.get $fa)) (global.set $kr_p_fb (local.get $fb)))
  ;; The dword stage both vc6 directions end in, after the lead: dw dwords
  ;; left, the dword pointer at $edi (ascending) or naming the top dword
  ;; (descending). 8+ is REP MOVSD (ECX 0, flags of `cmp ecx,8`); 1..7 is the
  ;; unrolled tail (ECX dw up / -dw down, flags of `add edi,eax` with eax =
  ;; +-4dw); 0 skips both (ECX 0, flags of `cmp ecx,8` up / `neg ecx` down).
  ;; Answers the sub-path 0 / 1 / 2.
  (func $kr_vc6_dw (param $dw i32) (param $edi i32) (param $edx i32) (param $down i32) (result i32)
    (if (i32.ge_u (local.get $dw) (i32.const 8))
      (then (call $kr_plan (i32.const 0) (local.get $edx) (i32.const 0) (local.get $dw) (i32.const 8))
            (return (i32.const 0))))
    (if (local.get $dw)
      (then
        (if (local.get $down)
          (then (call $kr_plan (i32.sub (i32.const 0) (local.get $dw)) (local.get $edx) (i32.const 1)
                  (local.get $edi) (i32.sub (i32.const 0) (i32.shl (local.get $dw) (i32.const 2)))))
          (else (call $kr_plan (local.get $dw) (local.get $edx) (i32.const 1)
                  (local.get $edi) (i32.shl (local.get $dw) (i32.const 2)))))
        (return (i32.const 1))))
    (if (local.get $down)
      (then (call $kr_plan (i32.const 0) (local.get $edx) (i32.const 0) (i32.const 0) (i32.const 0)))
      (else (call $kr_plan (i32.const 0) (local.get $edx) (i32.const 0) (i32.const 0) (i32.const 8))))
    (i32.const 2))
  ;; vc6 memcpy (= memmove). Paths: 0-2 up aligned (by $kr_vc6_dw), 3 up
  ;; unaligned n<4, 4-12 up lead a=dst&3 (4 + (a-1)*3 + sub), 13-15 down
  ;; aligned, 16 down unaligned n<4, 17-25 down lead a=(dst+n-4)&3; the
  ;; answer is path*2 + (dst > src), since that compare adds a branch.
  (func $kr_vc6 (param $d i32) (param $s i32) (param $n i32) (result i32)
    (local $gt i32) (local $a i32) (local $r i32) (local $e i32)
    (local.set $gt (i32.gt_u (local.get $d) (local.get $s)))
    (if (i32.eqz (i32.and (local.get $gt) (i32.lt_u (local.get $d) (i32.add (local.get $s) (local.get $n)))))
      (then
        (local.set $a (i32.and (local.get $d) (i32.const 3)))
        (if (i32.eqz (local.get $a))
          (then (return (i32.add (i32.shl (call $kr_vc6_dw (i32.shr_u (local.get $n) (i32.const 2)) (local.get $d)
                                             (i32.and (local.get $n) (i32.const 3)) (i32.const 0)) (i32.const 1))
                                 (local.get $gt)))))
        (if (i32.lt_u (local.get $n) (i32.const 4))
          (then (call $kr_plan (i32.sub (local.get $n) (i32.const 4)) (i32.const 3) (i32.const 0) (local.get $n) (i32.const 4))
                (return (i32.add (i32.const 6) (local.get $gt)))))
        ;; the lead copies 4-a bytes
        (local.set $r (i32.sub (local.get $n) (i32.sub (i32.const 4) (local.get $a))))
        (return (i32.add (i32.shl (i32.add (i32.add (i32.const 4) (i32.mul (i32.sub (local.get $a) (i32.const 1)) (i32.const 3)))
                                           (call $kr_vc6_dw (i32.shr_u (local.get $r) (i32.const 2))
                                             (i32.add (local.get $d) (i32.sub (i32.const 4) (local.get $a)))
                                             (i32.and (local.get $r) (i32.const 3)) (i32.const 0)))
                                  (i32.const 1))
                         (local.get $gt)))))
    ;; down: EDI starts at the top dword
    (local.set $e (i32.sub (i32.add (local.get $d) (local.get $n)) (i32.const 4)))
    (local.set $a (i32.and (local.get $e) (i32.const 3)))
    (if (i32.eqz (local.get $a))
      (then (return (i32.add (i32.shl (i32.add (i32.const 13)
                                        (call $kr_vc6_dw (i32.shr_u (local.get $n) (i32.const 2)) (local.get $e)
                                          (i32.and (local.get $n) (i32.const 3)) (i32.const 1)))
                                      (i32.const 1))
                             (i32.const 1)))))
    (if (i32.lt_u (local.get $n) (i32.const 4))
      (then (call $kr_plan (local.get $n) (i32.const 3) (i32.const 0) (local.get $n) (i32.const 4))
            (return (i32.const 33))))
    ;; the lead copies a bytes
    (local.set $r (i32.sub (local.get $n) (local.get $a)))
    (i32.add (i32.shl (i32.add (i32.add (i32.const 17) (i32.mul (i32.sub (local.get $a) (i32.const 1)) (i32.const 3)))
                               (call $kr_vc6_dw (i32.shr_u (local.get $r) (i32.const 2)) (i32.sub (local.get $e) (local.get $a))
                                 (i32.and (local.get $r) (i32.const 3)) (i32.const 1)))
                      (i32.const 1))
             (i32.const 1)))
  ;; vc4 memmove. Paths: 0 up aligned, 1 up unaligned n<=12 (REP MOVSB), 2 up
  ;; unaligned lead, 3 down aligned, 4 down unaligned n<=12, 5 down unaligned
  ;; lead; path*2 + (dst > src). The n<=12 paths leave the caller's EDX; the
  ;; down lead is (-EDX)&3 of the CALLER's EDX (the body never loads EDX on
  ;; that path before `neg edx`), which only moves where the bytes/dwords
  ;; split, not what lands where.
  (func $kr_vc4 (param $d i32) (param $s i32) (param $n i32) (param $edx i32) (result i32)
    (local $gt i32) (local $down i32) (local $l i32) (local $t i32)
    (local.set $gt (i32.gt_u (local.get $d) (local.get $s)))
    (local.set $down (i32.and (local.get $gt) (i32.lt_u (local.get $d) (i32.add (local.get $s) (local.get $n)))))
    (local.set $t (select (i32.add (local.get $d) (local.get $n)) (local.get $d) (local.get $down)))
    (if (i32.eqz (i32.and (local.get $t) (i32.const 3)))
      (then (call $kr_plan (i32.const 0) (i32.and (local.get $n) (i32.const 3)) (i32.const 2) (local.get $n) (i32.const 0))
            (return (i32.add (i32.shl (select (i32.const 3) (i32.const 0) (local.get $down)) (i32.const 1)) (local.get $gt)))))
    (if (i32.le_u (local.get $n) (i32.const 12))
      (then (call $kr_plan (i32.const 0) (local.get $edx) (i32.const 0) (local.get $n) (i32.const 12))
            (return (i32.add (i32.shl (select (i32.const 4) (i32.const 1) (local.get $down)) (i32.const 1)) (local.get $gt)))))
    (local.set $l (i32.and (i32.sub (i32.const 0) (select (local.get $edx) (local.get $d) (local.get $down))) (i32.const 3)))
    (call $kr_plan (i32.const 0) (local.get $l) (i32.const 2) (i32.sub (local.get $n) (local.get $l)) (i32.const 0))
    (i32.add (i32.shl (select (i32.const 5) (i32.const 2) (local.get $down)) (i32.const 1)) (local.get $gt)))

  ;; Does guest [a, a+n) overlap [b, b+m)? (neither wraps)
  (func $kr_overlap (param $a i32) (param $n i32) (param $b i32) (param $m i32) (result i32)
    (i32.and (i32.lt_u (local.get $a) (i32.add (local.get $b) (local.get $m)))
             (i32.lt_u (local.get $b) (i32.add (local.get $a) (local.get $n)))))
  ;; A span under the locked lazy GPU surface window (09a8gv): its first touch
  ;; has a readback the native copy must not reorder.
  (func $kr_gps (param $a i32) (param $n i32) (result i32)
    (if (i32.eqz (i32.atomic.load (region.addr $GPS_LAZY 4))) (then (return (i32.const 0))))
    (call $kr_overlap (local.get $a) (local.get $n) (global.get $DIB_GUEST_BASE) (global.get $DIB_GUEST_CAPACITY)))

  (func $kr_tick (param $id i32) (param $fb i32)
    (if (local.get $fb)
      (then
        (global.set $kr_fallback (i32.add (global.get $kr_fallback) (i32.const 1)))
        (if (i32.eq (local.get $id) (i32.const 1)) (then (global.set $kr_f1 (i32.add (global.get $kr_f1) (i32.const 1)))))
        (if (i32.eq (local.get $id) (i32.const 2)) (then (global.set $kr_f2 (i32.add (global.get $kr_f2) (i32.const 1)))))
        (if (i32.eq (local.get $id) (i32.const 3)) (then (global.set $kr_f3 (i32.add (global.get $kr_f3) (i32.const 1)))))
        (if (i32.eq (local.get $id) (i32.const 4)) (then (global.set $kr_f4 (i32.add (global.get $kr_f4) (i32.const 1)))))
        (return)))
    (global.set $kr_native (i32.add (global.get $kr_native) (i32.const 1)))
    (if (i32.eq (local.get $id) (i32.const 1)) (then (global.set $kr_n1 (i32.add (global.get $kr_n1) (i32.const 1)))))
    (if (i32.eq (local.get $id) (i32.const 2)) (then (global.set $kr_n2 (i32.add (global.get $kr_n2) (i32.const 1)))))
    (if (i32.eq (local.get $id) (i32.const 3)) (then (global.set $kr_n3 (i32.add (global.get $kr_n3) (i32.const 1)))))
    (if (i32.eq (local.get $id) (i32.const 4)) (then (global.set $kr_n4 (i32.add (global.get $kr_n4) (i32.const 1))))))

  ;; 396: a known CRT routine at its entry (operand = id, one word = entry
  ;; EIP), followed by the body's RET. Entered with ESP at the return address.
  (func $th_msvc_routine (param $op i32)
    (local $nx_fn i32) (local $nx_op i32)
    (local $id i32) (local $entry i32) (local $esp i32) (local $d i32) (local $s i32) (local $n i32)
    (local $path i32) (local $need i32)
    (local.set $id (local.get $op))
    (local.set $entry (read-thread-word))
    (local.set $esp (i32.load offset=16 (global.get $reg_base)))
    (block $fallback
     (block $commit
      (if (i32.eq (local.get $id) (i32.const 4))
        (then
          ;; strcmp: reads only; DF does not reach it
          (br_if $fallback (i32.or (global.get $selective_watch_on) (i32.eq (global.get $fault_unmapped) (i32.const 3))))
          (br_if $fallback (i32.gt_u (local.get $esp) (i32.const 0xFFFFFFF0)))
          (br_if $fallback (i32.eqz (call $string_guest_range_contiguous (i32.add (local.get $esp) (i32.const 4)) (i32.const 8))))
          (local.set $path (call $kr_strcmp (call $gl32 (i32.add (local.get $esp) (i32.const 4)))
                                            (call $gl32 (i32.add (local.get $esp) (i32.const 8)))))
          (br_if $fallback (i32.lt_s (local.get $path) (i32.const 0)))
          (local.set $need (call $kr_charge (local.get $id) (local.get $path)))
          (br_if $fallback (i32.lt_s (local.get $need) (i32.const 0)))
          (local.set $need (i32.add (local.get $need)
            (i32.mul (call $kr_slope (local.get $id) (local.get $path)) (global.get $kr_last_iters))))
          (br_if $fallback (i32.and (i32.ne (global.get $branch_clock) (i32.const 0))
                                    (i32.lt_s (global.get $block_budget) (local.get $need))))
          (if (global.get $branch_clock)
            (then (global.set $block_budget (i32.sub (global.get $block_budget) (local.get $need)))))
          (i32.store (global.get $reg_base) (global.get $kr_p_eax))
          (br $commit)))
      (br_if $fallback (global.get $df))
      (br_if $fallback (i32.or (i32.or (global.get $rep_store_step) (global.get $native_store_on))
                               (i32.or (global.get $selective_watch_on)
                                       (i32.eq (global.get $fault_unmapped) (i32.const 3)))))
      (br_if $fallback (i32.atomic.load offset=4 (global.get $WRITER_SESSION)))
      ;; the three pushes and the three argument words: [esp-12, esp+16)
      (br_if $fallback (i32.gt_u (local.get $esp) (i32.const 0xFFFFFFE0)))
      (br_if $fallback (i32.lt_u (local.get $esp) (i32.const 0x1000C)))
      (br_if $fallback (i32.eqz (call $string_guest_range_contiguous (i32.sub (local.get $esp) (i32.const 12)) (i32.const 28))))
      (local.set $d (call $gl32 (i32.add (local.get $esp) (i32.const 4))))
      (local.set $s (call $gl32 (i32.add (local.get $esp) (i32.const 8))))
      (local.set $n (call $gl32 (i32.add (local.get $esp) (i32.const 12))))
      (br_if $fallback (i32.lt_u (i32.add (local.get $d) (local.get $n)) (local.get $d)))
      (br_if $fallback (i32.lt_u (i32.add (local.get $s) (local.get $n)) (local.get $s)))
      (br_if $fallback (i32.eqz (call $string_guest_range_contiguous (local.get $d) (local.get $n))))
      (br_if $fallback (i32.eqz (call $string_guest_range_contiguous (local.get $s) (local.get $n))))
      (br_if $fallback (call $kr_overlap (local.get $d) (local.get $n) (i32.sub (local.get $esp) (i32.const 12)) (i32.const 28)))
      (br_if $fallback (call $kr_overlap (local.get $d) (local.get $n) (local.get $entry) (call $kr_len (local.get $id))))
      (br_if $fallback (i32.or (call $kr_gps (local.get $d) (local.get $n)) (call $kr_gps (local.get $s) (local.get $n))))
      (local.set $path
        (if (result i32) (i32.eq (local.get $id) (i32.const 3))
          (then (call $kr_vc4 (local.get $d) (local.get $s) (local.get $n) (i32.load offset=8 (global.get $reg_base))))
          (else (call $kr_vc6 (local.get $d) (local.get $s) (local.get $n)))))
      (local.set $need (call $kr_charge (local.get $id) (local.get $path)))
      (br_if $fallback (i32.lt_s (local.get $need) (i32.const 0)))
      (br_if $fallback (i32.and (i32.ne (global.get $branch_clock) (i32.const 0))
                                (i32.lt_s (global.get $block_budget) (local.get $need))))
      ;; committed: push ebp / push edi / push esi, the copy, the exit state
      (call $gs32 (i32.sub (local.get $esp) (i32.const 4)) (i32.load offset=20 (global.get $reg_base)))
      (call $gs32 (i32.sub (local.get $esp) (i32.const 8)) (i32.load offset=28 (global.get $reg_base)))
      (call $gs32 (i32.sub (local.get $esp) (i32.const 12)) (i32.load offset=24 (global.get $reg_base)))
      (call $guest_memmove (local.get $d) (local.get $s) (local.get $n))
      (if (global.get $branch_clock)
        (then (global.set $block_budget (i32.sub (global.get $block_budget) (local.get $need)))))
      (global.set $kr_last_iters (i32.const 0))
      (i32.store (global.get $reg_base) (local.get $d)))
      ;; both: ECX, EDX, the flags, the counters
      (i32.store offset=4 (global.get $reg_base) (global.get $kr_p_ecx))
      (i32.store offset=8 (global.get $reg_base) (global.get $kr_p_edx))
      ;; kind 0 SUB / 1 ADD / 2 SHR a,2 / 3 logic 0
      (block $fl
        (if (i32.eqz (global.get $kr_p_fk))
          (then (call $set_flags_sub (global.get $kr_p_fa) (global.get $kr_p_fb)
                  (i32.sub (global.get $kr_p_fa) (global.get $kr_p_fb))) (br $fl)))
        (if (i32.eq (global.get $kr_p_fk) (i32.const 1))
          (then (call $set_flags_add (global.get $kr_p_fa) (global.get $kr_p_fb)
                  (i32.add (global.get $kr_p_fa) (global.get $kr_p_fb))) (br $fl)))
        (if (i32.eq (global.get $kr_p_fk) (i32.const 2))
          (then (drop (call $do_shift32 (i32.const 5) (global.get $kr_p_fa) (i32.const 2))) (br $fl)))
        (call $set_flags_logic (i32.const 0)))
      (global.set $flag_sign_shift (i32.const 31))
      (global.set $kr_last_path (local.get $path))
      (global.set $kr_bytes (i64.add (global.get $kr_bytes) (i64.extend_i32_u (local.get $n))))
      (call $kr_tick (local.get $id) (i32.const 0))
      (dispatch-next))
    ;; Back to the guest body: perform its first instruction (`push ebp`, or
    ;; strcmp's `mov edx,[esp+4]`), resume after it. It is no branch, so the
    ;; resume's transfer is refunded.
    (call $kr_tick (local.get $id) (i32.const 1))
    (global.set $kr_last_path (i32.const -1))
    (global.set $block_budget (i32.add (global.get $block_budget) (global.get $branch_clock)))
    (if (i32.eq (local.get $id) (i32.const 4))
      (then (i32.store offset=8 (global.get $reg_base) (call $gl32 (i32.add (local.get $esp) (i32.const 4)))))
      (else
        (local.set $esp (i32.sub (local.get $esp) (i32.const 4)))
        (call $gs32 (local.get $esp) (i32.load offset=20 (global.get $reg_base)))
        (i32.store offset=16 (global.get $reg_base) (local.get $esp))))
    (global.set $eip (i32.add (local.get $entry) (call $kr_k (local.get $id))))
    (return_call $branch_end))

  ;; --known-routines=MASK / ?known-routines=MASK (bit = entry id). Decode-
  ;; time per instance: set it before the first decode (lib/worker-imports.js
  ;; carries it to threads).
  (func (export "set_known_routines") (param $mask i32)
    (global.set $known_routines (i32.and (local.get $mask) (i32.const 0x1E))))
  (func (export "get_known_routines") (result i32) (global.get $known_routines))
  (func (export "kr_last_path") (result i32) (global.get $kr_last_path))
  (func (export "kr_last_iters") (result i32) (global.get $kr_last_iters))
  (func (export "kr_charge") (param $id i32) (param $path i32) (result i32)
    (call $kr_charge (local.get $id) (local.get $path)))
  (func (export "kr_slope") (param $id i32) (param $path i32) (result i32)
    (call $kr_slope (local.get $id) (local.get $path)))
  ;; 0 native, 1 fallback, 2 SMC group drops, 3 MB copied natively,
  ;; 11-14 native per id, 21-24 fallback per id
  (func (export "known_routine_stat") (param $k i32) (result i32)
    (if (i32.eqz (local.get $k)) (then (return (global.get $kr_native))))
    (if (i32.eq (local.get $k) (i32.const 1)) (then (return (global.get $kr_fallback))))
    (if (i32.eq (local.get $k) (i32.const 2)) (then (return (global.get $kr_smc_drops))))
    (if (i32.eq (local.get $k) (i32.const 3)) (then (return (i32.wrap_i64 (i64.shr_u (global.get $kr_bytes) (i64.const 20))))))
    (if (i32.eq (local.get $k) (i32.const 11)) (then (return (global.get $kr_n1))))
    (if (i32.eq (local.get $k) (i32.const 12)) (then (return (global.get $kr_n2))))
    (if (i32.eq (local.get $k) (i32.const 13)) (then (return (global.get $kr_n3))))
    (if (i32.eq (local.get $k) (i32.const 21)) (then (return (global.get $kr_f1))))
    (if (i32.eq (local.get $k) (i32.const 22)) (then (return (global.get $kr_f2))))
    (if (i32.eq (local.get $k) (i32.const 23)) (then (return (global.get $kr_f3))))
    (if (i32.eq (local.get $k) (i32.const 14)) (then (return (global.get $kr_n4))))
    (if (i32.eq (local.get $k) (i32.const 24)) (then (return (global.get $kr_f4))))
    (i32.const 0))
