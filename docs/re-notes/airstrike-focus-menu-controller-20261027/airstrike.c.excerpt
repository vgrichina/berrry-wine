176:   while ( SDL_PollEvent(&event) >= 1 )
177:     {
178:       switch (event.type)
179: 	{
180: 	case SDL_QUIT:
181: 	  ret = 0;
182: 	  break;
183: 	case SDL_KEYDOWN:
184: 	  switch (event.key.keysym.sym)
185: 	    {
186: 	    case SDLK_ESCAPE:
187: 	      paused = 1 - paused;
188: 	      break;
189: 	    case SDLK_s:
190: 	      SDL_SaveBMP(sprite_global.display,"screenshot.bmp");
191: 	      break;
192: 	    default:
193: 	      break;
194: 	    }
195: 	  break;
196: 	default:
197: 	  break;
198: 	}
199:     }
200:   return ret;
201: }
202:
203: static int wait_for_key(void)
204: {
205:   SDL_Event event;
206:   while (1)
207:     {
208:       while ( SDL_PollEvent(&event) >= 1 )
209: 	{
210: 	  switch (event.type)
211: 	    {
212: 	    case SDL_QUIT:
213: 	      exit(EXIT_SUCCESS);
214: 	      break;
215: 	    case SDL_KEYDOWN:
216: 	      return event.key.keysym.sym;
217: 	      break;
218: 	    default:
219: 	      break;
220: 	    }
221: 	}
222:       SDL_Delay(sprite_global.display_dt);
223:     }
224: }
