501: /* Keeps track of dead planes, recreates them and award points */
502: void scorekeeper()
503: {
504:   char cbuf[200];
505:   sprite_t *s;
506:   int i;
507:
508:   /* This loop relies on MAXPLAYERS = 2 (great programming..)*/
509:   for (i=0;i<MAXPLAYERS;i++)
510:     {
667:     {
668:       if (!paused)
669: 	{
670: 	  game_frame();
671: 	}
672:       else
673: 	{
674: 	  console_mode();
675: 	  paused = 0;
676: 	}
677:     }
678:   /* We probably never get here right now, because of exit() calls. */
679:   fprintf(stderr,"Left main loop.\n");
680:   sprite_group_free(mech_group);
681:   sprite_group_free(bullet_group);
682:   sprite_group_free(effects_group);
683:   sprite_group_free(foreground_group);
684:   return EXIT_SUCCESS;
685: }
