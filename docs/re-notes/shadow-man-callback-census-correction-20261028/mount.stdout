{"sourceSHA256":"4d7b9587676db38fcf3314807acb2b2a42b5f09d2c98fcf3dccb8a6cde9e1809","parserSource":"const getArg = (name, def) => {\n  const prefix = `--${name}=`;\n  const arg = args.find(value => value.startsWith(prefix));\n  return arg ? arg.slice(prefix.length) : def;\n};\nconst getArgs = name => {\n  const prefix = `--${name}=`;\n  return args.filter(value => value.startsWith(prefix))\n    .flatMap(value => value.slice(prefix.length).split(','))\n    .map(value => value.trim()).filter(Boolean);\n};\n","actualArgv":[],"actualFilenameBearingMounts":[],"controlArgv":["--vfs-tree=/tmp/shadow-man-callback-census-correction-oct28/ops/mount-control"],"enumeratedFiles":["comma,bearing.txt"],"scope":"canonical parser control only; no guest or media mount invocation authorized","pass":true}
