+  assert.equal(f.reads(), reads, 'Close stops before reusing freed MSG');
+  assert.equal(e.scrsave_window(), 0); assert.equal(e.wat_app_pump(), 0);
+  assert.deepEqual(f.destroyed, [hwnd]); assert.ok(f.freed.includes(0x10000));
