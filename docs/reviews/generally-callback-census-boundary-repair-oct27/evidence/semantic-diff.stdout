+    return { left, leftDown: !!physical[left], rightDown: !!physical[left + 1] };
+  };
+
+  P._applyModifierSides = function(sides) {
+    if (!sides) return;
+    if (!this._asyncKeys) this._asyncKeys = Object.create(null);
+    this._asyncKeys[sides.left] = sides.leftDown;
+    this._asyncKeys[sides.left + 1] = sides.rightDown;
   };
 
