+      // Bare VK injection retains the legacy async previous-state fallback.
+      wasDown = side ? owners.has(side) : undefined;
+      if (down) owners.add(side);
+      else if (side) owners.delete(side);
+      else owners.clear();
+      this._physicalKeys[vk] = owners.size > 0;
+      const left = 160 + (vk - 16) * 2;
+      this._physicalKeys[left] = owners.has('left');
+      this._physicalKeys[left + 1] = owners.has('right');
+    } else this._physicalKeys[vk] = !!down;
+    return wasDown;
+  };
+
+  // Capture both sides at this event's queue position. Numeric aggregate
+  // owners hold neither side; their release clears both through poke above.
+  P._modifierSideSnapshot = function(vk) {
+    const left = 160 + (vk - 16) * 2;
